.page { min-height: 100vh; padding: 24rpx; background: #FFF8EC; }
.filters { margin-bottom: 18rpx; white-space: nowrap; }
.filter-row { display: inline-flex; gap: 12rpx; }
.filter, .tool-filter { padding: 12rpx 22rpx; border-radius: 30rpx; color: #8D6E63; background: #FFF3E6; font-size: 24rpx; }
.filter.active, .tool-filter.active { color: #FFFFFF; background: #FF8C42; }
.filter-tools { display: flex; flex-wrap: wrap; align-items: center; gap: 12rpx; margin-bottom: 22rpx; }
.clear { padding: 10rpx 4rpx; color: #C77231; font-size: 24rpx; }
.empty { padding-top: 180rpx; text-align: center; color: #BCAAA4; }
.log-item { display: flex; justify-content: space-between; align-items: center; margin-bottom: 12rpx; padding: 26rpx 28rpx; border-radius: 16rpx; background: #FFFFFF; }
.log-label { display: block; color: #5D4037; font-size: 30rpx; }
.log-time { display: block; margin-top: 8rpx; color: #BCAAA4; font-size: 23rpx; }
.log-arrow { color: #FF8C42; font-size: 36rpx; }
