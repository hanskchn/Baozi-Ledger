<view class="page">
  <scroll-view scroll-x class="filters"><view class="filter-row"><text wx:for="{{filters}}" wx:key="value" class="filter {{actionGroup === item.value ? 'active' : ''}}" data-value="{{item.value}}" bindtap="selectFilter">{{item.label}}</text></view></scroll-view>
  <view class="filter-tools">
    <text class="tool-filter {{operatorMemberId ? 'active' : ''}}" bindtap="selectOperator">{{operatorLabel}} ▾</text>
    <picker mode="date" value="{{dateStart}}" bindchange="onDateStartChange"><text class="tool-filter {{dateStart ? 'active' : ''}}">{{dateStart || '开始日期'}}</text></picker>
    <picker mode="date" value="{{dateEnd}}" bindchange="onDateEndChange"><text class="tool-filter {{dateEnd ? 'active' : ''}}">{{dateEnd || '结束日期'}}</text></picker>
    <text wx:if="{{dateStart || dateEnd}}" class="clear" bindtap="clearDateFilter">清除</text>
  </view>
  <view wx:if="{{logs.length === 0 && !loading}}" class="empty">暂无操作记录</view>
  <view wx:for="{{logs}}" wx:key="_id" class="log-item"><view><text class="log-label">{{item.label}}</text><text class="log-time">{{item.operatorName}} · {{item.time}}</text></view></view>
<privacy-popup />
</view>
