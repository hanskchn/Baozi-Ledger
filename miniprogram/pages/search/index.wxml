<view class="page">
  <view class="search-bar">
    <input class="search-input" placeholder="搜索备注、商家、金额" value="{{keyword}}" bindinput="onInput" bindconfirm="onSearch" focus="{{true}}" />
    <text class="search-btn" bindtap="onSearch">搜索</text>
  </view>

  <view class="result-list">
    <view class="empty-tip" wx:if="{{keyword && results.length === 0}}"><image wx:if="{{hasBrandAssets && !emptyImageFailed}}" class="empty-illustration" src="/images/brand/search-empty.png" mode="aspectFit" binderror="onEmptyImageError"></image><view wx:else class="empty-mark">🔍</view><text>未找到相关账单</text></view>
    <view class="empty-tip" wx:if="{{!keyword}}">输入关键词搜索账单</view>
    <view class="result-item" wx:for="{{results}}" wx:key="id" data-id="{{item.id}}" bindtap="onItemTap">
      <view class="result-icon">{{item.icon}}</view>
      <view class="result-info">
        <text class="result-category">{{item.category2}}</text>
        <text class="result-remark">{{item.remark}}</text>
        <text class="result-date">{{item.date}}</text>
      </view>
      <text class="result-amount {{item.type}}">{{item.type === 'expense' ? '-' : '+'}}¥{{item.amount}}</text>
    </view>
  </view>
<privacy-popup />
</view>
