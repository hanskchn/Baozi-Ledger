.page {
  padding: 0 0 40rpx;
}

.search-bar {
  display: flex;
  align-items: center;
  background: #fff;
  padding: 16rpx 24rpx;
}

.search-input {
  flex: 1;
  background: #f5f5f5;
  padding: 16rpx 24rpx;
  border-radius: 32rpx;
  font-size: 28rpx;
}

.search-btn {
  margin-left: 16rpx;
  font-size: 30rpx;
  color: #07C160;
}

.result-list {
  padding: 16rpx 24rpx;
}

.empty-tip {
  text-align: center;
  color: #bbb;
  font-size: 28rpx;
  padding: 80rpx 0;
}

.result-item {
  display: flex;
  align-items: center;
  background: #fff;
  padding: 24rpx;
  border-radius: 12rpx;
  margin-bottom: 12rpx;
}

.result-icon {
  width: 72rpx;
  height: 72rpx;
  line-height: 72rpx;
  text-align: center;
  font-size: 40rpx;
  background: #f5f5f5;
  border-radius: 50%;
  margin-right: 20rpx;
}

.result-info {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.result-category {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
}

.result-remark {
  font-size: 24rpx;
  color: #999;
  margin-top: 6rpx;
}

.result-date {
  font-size: 22rpx;
  color: #ccc;
  margin-top: 6rpx;
}

.result-amount {
  font-size: 32rpx;
  font-weight: 600;
}

.result-amount.expense {
  color: #333;
}

.result-amount.income {
  color: #07C160;
}
