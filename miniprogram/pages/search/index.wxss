.page {
  padding: 0 0 40rpx;
}

.search-bar {
  display: flex;
  align-items: center;
  background: #fff;
  padding: 16rpx 24rpx;
}

.search-input {
  flex: 1;
  background: #FFF3E6;
  padding: 16rpx 24rpx;
  border-radius: 32rpx;
  font-size: 28rpx;
}

.search-btn {
  margin-left: 16rpx;
  font-size: 30rpx;
  color: #D96A23;
}

.result-list {
  padding: 16rpx 24rpx;
}

.empty-tip {
  text-align: center;
  color: #bbb;
  font-size: 28rpx;
  padding: 80rpx 0;
}

.result-item {
  display: flex;
  align-items: center;
  background: #fff;
  padding: 24rpx;
  border-radius: 12rpx;
  margin-bottom: 12rpx;
}

.result-icon {
  width: 72rpx;
  height: 72rpx;
  line-height: 72rpx;
  text-align: center;
  font-size: 40rpx;
  background: #FFF3E6;
  border-radius: 50%;
  margin-right: 20rpx;
}

.result-info {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.result-category {
  font-size: 28rpx;
  color: #5D4037;
  font-weight: 500;
}

.result-remark {
  font-size: 24rpx;
  color: #999;
  margin-top: 6rpx;
}

.result-date {
  font-size: 22rpx;
  color: #ccc;
  margin-top: 6rpx;
}

.result-amount {
  font-size: 32rpx;
  font-weight: 600;
}

.result-amount.expense {
  color: #5D4037;
}

.result-amount.income {
  color: #4CAF50;
}

.empty-illustration { display: block; width: 160rpx; height: 128rpx; margin: 0 auto 16rpx; }
.empty-mark { width: 120rpx; height: 104rpx; display: flex; align-items: center; justify-content: center; border-radius: 50%; background: #FFF1D6; border: 2rpx solid #F6B84C; font-size: 48rpx; margin: 0 auto 16rpx; }
