.page {
  padding: 0 0 40rpx;
}

.month-bar {
  display: flex;
  align-items: center;
  background: #fff;
  padding: 20rpx 24rpx;
}

.month-arrow {
  font-size: 36rpx;
  color: #07C160;
  padding: 0 40rpx;
}

.month-text {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
}

.filter-bar {
  display: flex;
  align-items: center;
  background: #fff;
  padding: 16rpx 24rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.filter-item {
  flex: 1;
  text-align: center;
  font-size: 26rpx;
  color: #666;
  padding: 8rpx 12rpx;
  background: #f5f5f5;
  border-radius: 20rpx;
  margin: 0 8rpx;
}

.filter-item.active {
  background: #e8f8ee;
  color: #07C160;
}

.filter-search {
  width: 60rpx;
  text-align: center;
  font-size: 32rpx;
}

.bill-list {
  padding: 16rpx 24rpx;
}

.empty-tip {
  text-align: center;
  color: #bbb;
  font-size: 28rpx;
  padding: 120rpx 0;
}

.bill-group {
  margin-bottom: 16rpx;
}

.bill-date {
  font-size: 24rpx;
  color: #999;
  padding: 12rpx 8rpx;
}

.bill-item {
  display: flex;
  align-items: center;
  background: #fff;
  padding: 24rpx;
  border-radius: 12rpx;
  margin-bottom: 2rpx;
}

.bill-icon {
  width: 72rpx;
  height: 72rpx;
  line-height: 72rpx;
  text-align: center;
  font-size: 40rpx;
  background: #f5f5f5;
  border-radius: 50%;
  margin-right: 20rpx;
}

.bill-info {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.bill-category {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
}

.bill-remark {
  font-size: 24rpx;
  color: #999;
  margin-top: 6rpx;
}

.bill-amount {
  font-size: 32rpx;
  font-weight: 600;
}

.bill-amount.expense {
  color: #333;
}

.bill-amount.income {
  color: #07C160;
}
