.page {
  padding: 0 0 40rpx;
  background: #FFF8EC;
}

.top-card {
  position: sticky;
  top: 0;
  z-index: 100;
  margin: 0;
  padding: 20rpx 24rpx;
  background: #FFFFFF;
  border-radius: 0 0 20rpx 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(93, 64, 55, .08);
}

.top-card::before {
  content: "";
  position: absolute;
  left: 0;
  right: 0;
  top: -100rpx;
  height: 100rpx;
  background: #FFFFFF;
}

.top-card::after {
  content: "";
  position: absolute;
  left: 0;
  right: 0;
  bottom: -20rpx;
  height: 20rpx;
  background: #FFFFFF;
}

.top-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.period-nav {
  display: flex;
  align-items: center;
  flex: 1;
  min-width: 0;
}

.period-arrow {
  width: 56rpx;
  height: 56rpx;
  line-height: 52rpx;
  text-align: center;
  font-size: 36rpx;
  color: #FF8C42;
  background: #FFF3E6;
  border-radius: 50%;
}

.period-picker {
  display: flex;
  align-items: center;
  padding: 0 8rpx;
  flex: 1;
  min-width: 0;
}

.period-label {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: #5D4037;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.period-caret {
  margin-left: 6rpx;
  font-size: 20rpx;
  color: #FF8C42;
}

.top-actions {
  display: flex;
  align-items: center;
  gap: 16rpx;
  flex-shrink: 0;
}

.icon-btn {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 64rpx;
  height: 64rpx;
  background: #FFF3E6;
  border-radius: 50%;
}

.icon-btn.active {
  background: #FF8C42;
}

.icon-btn.active .icon-btn-glyph {
  color: #fff;
}

.icon-btn-hover {
  opacity: .7;
}

.icon-btn-glyph {
  font-size: 28rpx;
  color: #8D6E63;
}

.icon-btn-badge {
  min-width: 30rpx;
  height: 30rpx;
  line-height: 30rpx;
  padding: 0 6rpx;
  position: absolute;
  top: -6rpx;
  right: -6rpx;
  background: #E0503C;
  color: #fff;
  font-size: 20rpx;
  font-weight: 600;
  border-radius: 15rpx;
  text-align: center;
  box-sizing: border-box;
}

.icon-btn.active .icon-btn-badge {
  background: #fff;
  color: #E0503C;
}

.filter-bar {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding-top: 16rpx;
}

.chip-scroll {
  flex: 1;
  min-width: 0;
  white-space: nowrap;
}

.chip-row {
  display: inline-flex;
  gap: 12rpx;
  padding: 4rpx 0;
}

.chip {
  display: flex;
  align-items: center;
  gap: 8rpx;
  flex-shrink: 0;
  padding: 8rpx 18rpx;
  background: #FFF3E6;
  border-radius: 20rpx;
  font-size: 24rpx;
  color: #D96A23;
  white-space: nowrap;
}

.chip-hover {
  opacity: .65;
}

.chip-label {
  max-width: 280rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.chip-close {
  font-size: 28rpx;
  line-height: 1;
  color: #D96A23;
}

.clear-link {
  flex-shrink: 0;
  font-size: 24rpx;
  color: #8D6E63;
  padding: 8rpx 4rpx;
}

.time-sheet-mask {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0, 0, 0, .4);
  z-index: 200;
}

.time-sheet {
  position: fixed;
  left: 0; right: 0; top: 40vh; bottom: 0;
  background: #FFF8EC;
  border-radius: 24rpx 24rpx 0 0;
  z-index: 201;
  padding-bottom: env(safe-area-inset-bottom);
  display: flex;
  flex-direction: column;
}

.time-sheet-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 32rpx;
  flex-shrink: 0;
}

.time-sheet-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #5D4037;
}

.time-sheet-close {
  font-size: 36rpx;
  color: #B0A094;
  padding: 0 8rpx;
}

.time-sheet-body {
  flex: 1;
  min-height: 0;
  height: 0;
  padding: 0 32rpx 32rpx;
}

.quick-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.quick-chip {
  min-width: 140rpx;
  padding: 18rpx 28rpx;
  text-align: center;
  font-size: 28rpx;
  color: #8D6E63;
  background: #FFFFFF;
  border-radius: 36rpx;
}

.quick-chip.small {
  min-width: auto;
  padding: 12rpx 28rpx;
  font-size: 26rpx;
}

.quick-chip.active {
  background: linear-gradient(135deg, #FF8C42 0%, #FF6B35 100%);
  color: #fff;
  font-weight: 600;
}

.time-section {
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 20rpx;
}

.time-section-head {
  margin-bottom: 16rpx;
}

.picker-field {
  display: block;
  padding: 20rpx 32rpx;
  background: #FFF3E6;
  border-radius: 12rpx;
  font-size: 30rpx;
  color: #5D4037;
  text-align: center;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.range-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.range-row picker {
  flex: 1;
  min-width: 0;
}

.range-sep {
  font-size: 26rpx;
  color: #B0A094;
  flex-shrink: 0;
  width: 40rpx;
  text-align: center;
}

.bill-list {
  padding: 0 24rpx;
}

.empty-tip {
  text-align: center;
  color: #bbb;
  font-size: 28rpx;
  padding: 120rpx 0;
}

.bill-group {
  margin-bottom: 16rpx;
}

.bill-date {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  padding: 16rpx 8rpx 10rpx;
}

.bill-date-label {
  font-size: 24rpx;
  color: #8D6E63;
  font-weight: 500;
}

.bill-date-sum {
  font-size: 22rpx;
  color: #B0A094;
}

.sum-expense {
  color: #FF6B35;
  margin-left: 12rpx;
}

.sum-income {
  color: #4CAF50;
  margin-left: 12rpx;
}

.bill-item {
  display: flex;
  align-items: flex-start;
  background: #fff;
  padding: 22rpx 24rpx;
  border-radius: 16rpx;
  margin-bottom: 2rpx;
}

.bill-icon {
  width: 76rpx;
  height: 76rpx;
  line-height: 76rpx;
  text-align: center;
  font-size: 42rpx;
  background: #FFF3E6;
  border-radius: 50%;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.bill-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  min-width: 0;
}

.bill-category {
  font-size: 28rpx;
  color: #5D4037;
  font-weight: 500;
}

.bill-line1 {
  display: flex;
  align-items: center;
}

.bill-merchant {
  margin-left: 10rpx;
  font-size: 24rpx;
  color: #A58D80;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  max-width: 280rpx;
}

.bill-meta {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 8rpx 16rpx;
  margin-top: 8rpx;
}

.meta-item {
  font-size: 22rpx;
  line-height: 1.6;
  color: #B0A094;
}

.bill-remark {
  font-size: 24rpx;
  color: #999;
  margin-top: 8rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.bill-amount {
  font-size: 32rpx;
  font-weight: 600;
  flex-shrink: 0;
  margin-left: 16rpx;
  padding-top: 4rpx;
}

.bill-amount.expense {
  color: #FF6B35;
}

.bill-amount.income {
  color: #4CAF50;
}

.bill-swipe-wrap {
  position: relative;
  overflow: hidden;
  border-radius: 12rpx;
  margin-bottom: 2rpx;
}
.bill-swipe-content {
  position: relative;
  width: 100%;
  background: #fff;
  border-radius: 12rpx;
  z-index: 1;
}
.bill-swipe-content .bill-item {
  margin-bottom: 0;
  border-radius: 12rpx;
}
.bill-swipe-content.open {
  border-radius: 12rpx 0 0 12rpx;
}
.bill-delete {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  width: 180rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #E0503C;
  color: #FFFFFF;
  font-size: 30rpx;
  font-weight: 600;
  border-radius: 0 12rpx 12rpx 0;
  z-index: 0;
}
