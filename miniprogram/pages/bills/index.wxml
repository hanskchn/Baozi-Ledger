<view class="page">
  <!-- 顶部控制区 -->
  <view class="top-card">
    <view class="top-bar">
      <view class="period-nav">
        <view class="period-arrow" data-delta="-1" bindtap="changeMonth">‹</view>
        <view class="period-picker" bindtap="openTimeSheet">
          <text class="period-label">{{periodDisplay}}</text>
          <text class="period-caret">▾</text>
        </view>
        <view class="period-arrow" data-delta="1" bindtap="changeMonth">›</view>
      </view>
      <view class="top-actions">
        <view class="icon-btn {{hasActiveFilters ? 'active' : ''}}" bindtap="openFilter" hover-class="icon-btn-hover" hover-stay-time="80">
          <text class="icon-btn-glyph">⚙</text>
          <text wx:if="{{activeFilterCount > 0}}" class="icon-btn-badge">{{activeFilterCount}}</text>
        </view>
        <view class="icon-btn" bindtap="goSearch" hover-class="icon-btn-hover" hover-stay-time="80">
          <text class="icon-btn-glyph">🔍</text>
        </view>
      </view>
    </view>

    <view wx:if="{{activeFilterTags.length > 0}}" class="filter-bar">
      <scroll-view scroll-x class="chip-scroll" enhanced show-scrollbar="{{false}}">
        <view class="chip-row">
          <view wx:for="{{activeFilterTags}}" wx:key="key" class="chip" data-key="{{item.key}}" bindtap="removeFilterTag" hover-class="chip-hover" hover-stay-time="80">
            <text class="chip-label">{{item.label}}</text>
            <text class="chip-close">×</text>
          </view>
        </view>
      </scroll-view>
      <text class="clear-link" bindtap="clearFilters">清空</text>
    </view>
  </view>

  <!-- 时间选择弹层 -->
  <view class="time-sheet-mask" wx:if="{{showTimeSheet}}" bindtap="closeTimeSheet"></view>
  <view class="time-sheet" wx:if="{{showTimeSheet}}" catchtap="stopPropagation">
    <view class="time-sheet-header">
      <text class="time-sheet-title">选择时间</text>
      <text class="time-sheet-close" bindtap="closeTimeSheet">✕</text>
    </view>
    <scroll-view scroll-y class="time-sheet-body">
      <view class="quick-grid">
        <view class="quick-chip {{quick === 'thisMonth' ? 'active' : ''}}" data-key="thisMonth" bindtap="selectQuick">本月</view>
        <view class="quick-chip {{quick === 'lastMonth' ? 'active' : ''}}" data-key="lastMonth" bindtap="selectQuick">上月</view>
        <view class="quick-chip {{quick === 'thisYear' ? 'active' : ''}}" data-key="thisYear" bindtap="selectQuick">今年</view>
        <view class="quick-chip {{quick === 'all' ? 'active' : ''}}" data-key="all" bindtap="selectQuick">全部</view>
      </view>
      <view class="time-section">
        <view class="time-section-head">
          <text class="quick-chip small {{quick === 'custom' && timeMode === 'month' ? 'active' : ''}}" data-key="customMonth" bindtap="selectQuick">选择月份</text>
        </view>
        <picker wx:if="{{timeMode === 'month'}}" mode="date" fields="month" value="{{tempMonth}}" bindchange="onTempMonthChange">
          <view class="picker-field">{{tempMonth || '请选择月份'}}</view>
        </picker>
      </view>
      <view class="time-section">
        <view class="time-section-head">
          <text class="quick-chip small {{quick === 'custom' && timeMode === 'range' ? 'active' : ''}}" data-key="customRange" bindtap="selectQuick">自定义范围</text>
        </view>
        <view wx:if="{{timeMode === 'range'}}" class="range-row">
          <picker mode="date" value="{{tempDateStart}}" bindchange="onTempStartChange">
            <view class="picker-field">{{tempDateStart || '开始日期'}}</view>
          </picker>
          <text class="range-sep">至</text>
          <picker mode="date" value="{{tempDateEnd}}" bindchange="onTempEndChange">
            <view class="picker-field">{{tempDateEnd || '结束日期'}}</view>
          </picker>
        </view>
      </view>
    </scroll-view>
  </view>

  <!-- 账单列表 -->
  <view class="bill-list">
    <view class="empty-tip" wx:if="{{bills.length === 0 && !loading && !loadingMore}}">暂无账单记录</view>
    <view class="list-loading" wx:if="{{loading && bills.length === 0}}"><view class="loading-spinner"></view><text>账单加载中…</text></view>
    <view class="bill-group" wx:for="{{billGroups}}" wx:for-item="group" wx:key="day">
      <view class="bill-date">
        <text class="bill-date-label">{{group.title}}</text>
        <text class="bill-date-sum">
          <text wx:if="{{group.expense !== '0.00'}}" class="sum-expense">支出 ¥{{group.expense}}</text>
          <text wx:if="{{group.income !== '0.00'}}" class="sum-income">收入 ¥{{group.income}}</text>
        </text>
      </view>
      <view class="bill-swipe-wrap" wx:for="{{group.items}}" wx:for-item="item" wx:key="_id">
        <view class="bill-delete" data-id="{{item._id}}" data-can-operate="{{item.canOperate}}" bindtap="onDeleteTap">删除</view>
        <view
          class="bill-swipe-content {{slidBillId === item._id ? 'open' : ''}}"
          style="transform: translateX({{swipeOffsetMap[item._id] !== undefined ? swipeOffsetMap[item._id] : (slidBillId === item._id ? -180 : 0)}}rpx); {{swipeAnimating ? '' : 'transition: transform 0.25s cubic-bezier(0.25, 0.46, 0.45, 0.94);'}}"
          data-id="{{item._id}}"
          data-can-operate="{{item.canOperate}}"
          bindtouchstart="onSwipeStart"
          bindtouchmove="onSwipeMove"
          bindtouchend="onSwipeEnd"
        >
          <view class="bill-item" data-id="{{item._id}}" data-can-operate="{{item.canOperate}}" catchtap="onItemTap">
            <view class="bill-icon">{{item.category2Icon || '📝'}}</view>
            <view class="bill-info">
              <view class="bill-line1">
                <text class="bill-category">{{item.category2}}</text>
                <text wx:if="{{item.merchant}}" class="bill-merchant">· {{item.merchant}}</text>
              </view>
              <view class="bill-meta">
                <text wx:if="{{item.account}}" class="meta-item">💳 {{item.account}}</text>
                <text wx:if="{{item.member}}" class="meta-item">👤 {{item.member}}</text>
                <text wx:if="{{item.displayTime}}" class="meta-item">{{item.displayTime}}</text>
              </view>
              <text wx:if="{{item.remark}}" class="bill-remark">备注：{{item.remark}}</text>
            </view>
            <text class="bill-amount {{item.type}}">{{item.type === 'expense' ? '-' : '+'}}¥{{item.displayAmount}}</text>
          </view>
        </view>
      </view>
    </view>
    <view class="list-footer" wx:if="{{bills.length > 0 && loadingMore}}"><view class="loading-spinner small"></view><text>加载更多…</text></view>
    <view class="list-footer" wx:if="{{bills.length > 0 && !loadingMore && !hasMore}}">— 没有更多账单了 —</view>
  </view>
<privacy-popup />
<announcement-popup />
</view>
