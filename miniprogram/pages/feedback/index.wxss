.page {
  min-height: 100vh;
  background: #FFF8EC;
  padding-bottom: calc(60rpx + env(safe-area-inset-bottom));
}

.tabs {
  display: flex;
  background: #fff;
  padding: 0 24rpx;
  border-bottom: 1rpx solid #F0E6D6;
  position: sticky;
  top: 0;
  z-index: 10;
}
.tab {
  flex: 1;
  text-align: center;
  padding: 24rpx 0;
  font-size: 30rpx;
  color: #8D6E63;
  position: relative;
}
.tab.active {
  color: #FF8C42;
  font-weight: 600;
}
.tab.active::after {
  content: "";
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 48rpx;
  height: 6rpx;
  border-radius: 3rpx;
  background: #FF8C42;
}
.tab-dot {
  display: inline-block;
  min-width: 32rpx;
  height: 32rpx;
  line-height: 32rpx;
  padding: 0 8rpx;
  margin-left: 8rpx;
  font-size: 20rpx;
  color: #fff;
  background: #E85D5D;
  border-radius: 16rpx;
  vertical-align: middle;
}

.tab-body { padding: 24rpx; }

.card {
  background: #fff;
  border-radius: 20rpx;
  padding: 28rpx 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(93, 64, 55, 0.06);
}
.field-label {
  font-size: 26rpx;
  color: #8D6E63;
  margin-bottom: 16rpx;
}

.type-row { display: flex; gap: 16rpx; }
.type-chip {
  flex: 1;
  text-align: center;
  padding: 18rpx 0;
  border-radius: 14rpx;
  border: 2rpx solid #F0E6D6;
  font-size: 26rpx;
  color: #5D4037;
  background: #fff;
}
.type-chip.active {
  border-color: #FF8C42;
  background: #FFF3E6;
  color: #FF6B35;
  font-weight: 600;
}

.content-input {
  width: 100%;
  min-height: 180rpx;
  font-size: 28rpx;
  line-height: 1.6;
  color: #5D4037;
}
.placeholder { color: #BCAAA4; }
.counter { text-align: right; font-size: 22rpx; color: #BCAAA4; margin-top: 8rpx; }

.img-row { display: flex; flex-wrap: wrap; gap: 16rpx; }
.img-thumb {
  width: 140rpx;
  height: 140rpx;
  border-radius: 12rpx;
  position: relative;
  overflow: hidden;
  background: #F5EDE0;
}
.img-el { width: 100%; height: 100%; }
.img-del {
  position: absolute;
  top: -10rpx;
  right: -10rpx;
  width: 36rpx;
  height: 36rpx;
  line-height: 32rpx;
  text-align: center;
  border-radius: 50%;
  background: rgba(0,0,0,0.55);
  color: #fff;
  font-size: 28rpx;
}
.img-add {
  width: 140rpx;
  height: 140rpx;
  border-radius: 12rpx;
  border: 2rpx dashed #D9C7AF;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #BCAAA4;
}
.img-add-plus { font-size: 48rpx; line-height: 1; }
.img-add-tip { font-size: 22rpx; margin-top: 6rpx; }

.submit-btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 44rpx;
  background: #FF8C42;
  color: #fff;
  font-size: 30rpx;
  font-weight: 600;
  margin-top: 8rpx;
  box-shadow: 0 8rpx 20rpx rgba(255, 140, 66, 0.3);
}
.tips {
  text-align: center;
  font-size: 22rpx;
  color: #BCAAA4;
  margin-top: 20rpx;
  line-height: 1.6;
}

.empty { text-align: center; padding: 120rpx 0; }
.empty-icon { font-size: 80rpx; }
.empty-text { color: #BCAAA4; font-size: 26rpx; margin-top: 16rpx; }

.fb-item {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(93, 64, 55, 0.06);
}
.fb-item-top { display: flex; justify-content: space-between; align-items: center; margin-bottom: 12rpx; }
.fb-type {
  font-size: 22rpx;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  background: #FFF3E6;
  color: #FF8C42;
}
.fb-type.bug { background: #FDE0E0; color: #E85D5D; }
.fb-type.other { background: #EFEBE9; color: #8D6E63; }
.badge { font-size: 22rpx; padding: 4rpx 16rpx; border-radius: 20rpx; }
.badge-pending { background: #FFF3E0; color: #E89100; }
.badge-processing { background: #E3F2FD; color: #1976D2; }
.badge-resolved { background: #FFF1D6; color: #8B5E34; }
.badge-closed { background: #EFEBE9; color: #8D6E63; }

.fb-content {
  font-size: 28rpx;
  color: #5D4037;
  line-height: 1.5;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}
.reply-box {
  margin-top: 16rpx;
  background: #FFF8EC;
  border-left: 6rpx solid #FF8C42;
  border-radius: 8rpx;
  padding: 16rpx;
}
.reply-label { font-size: 22rpx; color: #FF8C42; font-weight: 600; }
.reply-text { font-size: 26rpx; color: #5D4037; line-height: 1.5; margin-top: 6rpx; }
.reply-hint { margin-top: 12rpx; font-size: 24rpx; color: #E85D5D; }
.reply-dot { display: inline-block; width: 12rpx; height: 12rpx; border-radius: 50%; background: #E85D5D; vertical-align: middle; margin-right: 6rpx; }
.fb-meta { display: flex; justify-content: space-between; font-size: 22rpx; color: #BCAAA4; margin-top: 12rpx; }

.load-more { text-align: center; padding: 24rpx; color: #FF8C42; font-size: 26rpx; }
.load-end { text-align: center; padding: 24rpx; color: #BCAAA4; font-size: 24rpx; }

.dev-id {
  text-align: center;
  font-size: 20rpx;
  color: #D9C7AF;
  margin-top: 16rpx;
  word-break: break-all;
}
