.login-page {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  /* 底部安全区用独立属性，避免 calc 混用 rpx 与 env 在部分基础库下失效 */
  padding: 140rpx 48rpx 48rpx;
  padding-bottom: calc(48rpx + env(safe-area-inset-bottom));
  background: linear-gradient(180deg, #FFF3E6 0%, #FFF8EC 60%);
  box-sizing: border-box;
}

.login-hero {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 0 20rpx;
}

.login-logo {
  width: 240rpx;
  height: 240rpx;
}

.login-logo-text {
  font-size: 56rpx;
  font-weight: 600;
  color: var(--primary-deep);
}

/* 主标语：最高层级，稍加字距更显舒缓 */
.login-slogan {
  margin-top: 48rpx;
  font-size: 38rpx;
  font-weight: 600;
  line-height: 56rpx;
  letter-spacing: 2rpx;
  color: var(--text-primary);
  text-align: center;
}

/* 副标语：说明功能，允许换行居中 */
.login-subtitle {
  margin-top: 20rpx;
  max-width: 520rpx;
  font-size: 27rpx;
  line-height: 44rpx;
  color: var(--text-secondary);
  text-align: center;
}

/* 尾句：最轻，作为节奏收尾 */
.login-tagline {
  margin-top: 14rpx;
  font-size: 25rpx;
  line-height: 36rpx;
  letter-spacing: 1rpx;
  color: var(--text-tertiary);
  text-align: center;
}

.login-checking {
  margin-top: auto;
  padding-bottom: 120rpx;
  text-align: center;
}

.login-checking-text {
  font-size: 26rpx;
  color: var(--text-tertiary);
}

.login-card {
  /* 表单沉到屏幕底部，靠近拇指操作区 */
  margin-top: auto;
  padding: 40rpx 32rpx 48rpx;
  background: #ffffff;
  border-radius: 32rpx;
  box-shadow: 0 -8rpx 32rpx rgba(93, 64, 55, 0.08);
}

.login-field {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #F5EBE0;
}

.login-label {
  font-size: 28rpx;
  color: var(--text-primary);
}

.login-input {
  flex: 1;
  margin-left: 32rpx;
  text-align: right;
  font-size: 28rpx;
  color: var(--text-primary);
}

.login-submit {
  /* 用 flex 居中，避免小程序按钮默认 padding 导致文字偏移 */
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 48rpx;
  padding: 0;
  height: 92rpx;
  line-height: 1;
  border-radius: 46rpx;
  background: var(--primary);
  color: #ffffff;
  font-size: 32rpx;
  font-weight: 600;
}

.login-submit.is-loading {
  opacity: 0.8;
}

.login-skip {
  display: block;
  margin-top: 28rpx;
  text-align: center;
  font-size: 26rpx;
  color: var(--text-secondary);
}

.login-agreement {
  display: block;
  margin-top: 32rpx;
  font-size: 22rpx;
  line-height: 34rpx;
  color: var(--text-tertiary);
}
