.page {
  padding-bottom: 200rpx;
}

.export-list {
  background: #fff;
  margin: 0 24rpx;
  border-radius: 16rpx;
  overflow: hidden;
}

.export-row {
  display: flex;
  align-items: center;
  padding: 28rpx 32rpx;
  border-bottom: 2rpx solid #F5F5F5;
}

.export-row:last-child { border-bottom: none; }

.export-row-left {
  display: flex;
  align-items: center;
  flex: 0 0 200rpx;
}

.export-icon {
  font-size: 32rpx;
  margin-right: 16rpx;
}

.export-label {
  font-size: 30rpx;
  color: #5D4037;
}

.export-value {
  flex: 1;
  text-align: right;
  font-size: 28rpx;
  color: #999;
}

.export-value.active {
  color: #D96A23;
  font-weight: 600;
}

.export-arrow {
  margin-left: 12rpx;
  font-size: 28rpx;
  color: #BCAAA4;
  transition: transform 0.2s;
}
.export-arrow.up {
  transform: rotate(90deg);
}

.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  padding: 16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom));
  background: #fff;
  border-top: 2rpx solid #F5F5F5;
}

.btn-reset, .btn-export {
  flex: 1;
  text-align: center;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 44rpx;
  font-size: 32rpx;
  font-weight: 600;
}

.btn-reset {
  background: #fff;
  color: #5D4037;
  border: 2rpx solid #D7CCC8;
  margin-right: 16rpx;
}

.btn-export {
  background: linear-gradient(135deg, #FF8C42 0%, #FF6B35 100%);
  color: #fff;
  box-shadow: 0 6rpx 18rpx rgba(255, 107, 53, 0.3);
}

.btn-export[disabled] {
  background: #E0D5CA;
  box-shadow: none;
  color: #fff;
}

/* 时间弹层（与 filter 一致） */
.time-sheet-mask, .cat-sheet-mask {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0, 0, 0, 0.4);
  z-index: 100;
}

.time-sheet {
  position: fixed;
  left: 0; right: 0; bottom: 0;
  background: #fff;
  border-radius: 24rpx 24rpx 0 0;
  z-index: 101;
  max-height: 80vh;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}
.time-sheet .time-sheet-body {
  overflow-y: auto;
  -webkit-overflow-scrolling: touch;
}

.cat-sheet {
  position: fixed;
  left: 0; right: 0; bottom: 0;
  background: #FFF8EC;
  border-radius: 24rpx 24rpx 0 0;
  z-index: 101;
  height: 80vh;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.time-sheet-header, .cat-sheet-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 32rpx;
  border-bottom: 2rpx solid #F5F5F5;
  flex: 0 0 auto;
}

.time-sheet-title, .cat-sheet-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #5D4037;
}

.time-sheet-close, .cat-sheet-close {
  font-size: 32rpx;
  color: #BCAAA4;
  padding: 8rpx;
}

.time-sheet-body {
  flex: 0 0 auto;
  padding: 16rpx 32rpx;
  box-sizing: border-box;
}
.cat-sheet-body {
  flex: 1 1 auto;
  padding: 16rpx 32rpx;
  min-height: 0;
  height: 0;
  box-sizing: border-box;
}

.time-sheet-footer, .cat-sheet-footer {
  display: flex;
  padding: 16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom));
  border-top: 2rpx solid #F5F5F5;
  flex: 0 0 auto;
  background: #fff;
}

.time-btn-cancel, .time-btn-confirm, .cat-btn-cancel, .cat-btn-confirm {
  flex: 1;
  text-align: center;
  height: 80rpx;
  line-height: 80rpx;
  border-radius: 40rpx;
  font-size: 30rpx;
  font-weight: 600;
}

.time-btn-cancel, .cat-btn-cancel {
  background: #fff;
  color: #5D4037;
  border: 2rpx solid #D7CCC8;
  margin-right: 16rpx;
}

.time-btn-confirm, .cat-btn-confirm {
  background: linear-gradient(135deg, #FF8C42 0%, #FF6B35 100%);
  color: #fff;
}

.quick-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.quick-chip {
  padding: 12rpx 24rpx;
  background: #FFF3E6;
  color: #D96A23;
  border-radius: 24rpx;
  font-size: 26rpx;
}

.quick-chip.active {
  background: #D96A23;
  color: #fff;
}

.quick-chip.small {
  padding: 8rpx 16rpx;
  font-size: 24rpx;
}

.time-section { margin-bottom: 24rpx; }

.time-section-head { margin-bottom: 12rpx; }

.picker-field {
  padding: 16rpx 24rpx;
  background: #FFF3E6;
  border-radius: 12rpx;
  font-size: 28rpx;
  color: #5D4037;
  display: inline-block;
  margin-right: 16rpx;
}

.range-row {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 12rpx;
}

.range-sep { color: #999; font-size: 26rpx; }

/* 分类分组小标题（支出/收入） */
.cat-section-title {
  font-size: 24rpx;
  color: #8D6E63;
  font-weight: 600;
  padding: 8rpx 8rpx 12rpx;
  letter-spacing: 1rpx;
}

/* 全部分类 */
.cat-all {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 24rpx 28rpx;
  margin-bottom: 16rpx;
  background: #FFFFFF;
  border-radius: 16rpx;
  font-size: 28rpx;
  color: #5D4037;
}
.cat-all.active {
  background: #FF8C42;
  color: #fff;
  font-weight: 600;
}
.cat-all-icon { font-size: 36rpx; }

/* 一级分组 */
.cat-group {
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 16rpx;
}
.cat-group-head {
  display: flex;
  align-items: center;
  gap: 10rpx;
}
.cat-group-head.active .cat-group-name { color: #FF6B35; }
.cat-group-icon { font-size: 32rpx; }
.cat-group-name { font-size: 28rpx; font-weight: 600; color: #5D4037; flex: 1; }
.cat-group-check { font-size: 30rpx; color: #FF6B35; font-weight: 700; }
.cat-group-type {
  font-size: 20rpx;
  padding: 2rpx 12rpx;
  border-radius: 16rpx;
}
.cat-group-type.type-expense { background: #FFF3E6; color: #FF6B35; }
.cat-group-type.type-income { background: #E8F5E9; color: #4CAF50; }

/* 二级胶囊 */
.cat-children {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  padding-top: 16rpx;
  margin-top: 16rpx;
  border-top: 1rpx solid #F5EFE6;
}
.cat-child {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 14rpx 24rpx;
  background: #FFF8EC;
  border-radius: 32rpx;
  font-size: 26rpx;
  color: #5D4037;
}
.cat-child.active {
  background: #FF8C42;
  color: #fff;
  font-weight: 600;
}
.cat-child-icon { font-size: 28rpx; }

.cat-empty {
  text-align: center;
  color: #BCAAA4;
  font-size: 26rpx;
  padding: 60rpx 0;
}

/* 行内 chip 多选面板（账户/成员） */
.chip-panel {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  padding: 20rpx 32rpx 24rpx;
  background: #fff;
  margin: 0 24rpx;
  border-bottom: 2rpx solid #F5F5F5;
}
.chip {
  padding: 14rpx 32rpx;
  background: #F5F5F5;
  color: #5D4037;
  border-radius: 32rpx;
  font-size: 26rpx;
}
.chip.active {
  background: linear-gradient(135deg, #FF8C42 0%, #FF6B35 100%);
  color: #fff;
  font-weight: 600;
}
.chip-empty {
  color: #BCAAA4;
  font-size: 26rpx;
  padding: 12rpx 0;
}

/* ===== 导出进度遮罩 ===== */
.export-progress-mask {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0, 0, 0, 0.45);
  z-index: 300;
  display: flex;
  align-items: center;
  justify-content: center;
}
.export-progress-card {
  width: 560rpx;
  background: #fff;
  border-radius: 24rpx;
  padding: 48rpx 40rpx 36rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-shadow: 0 12rpx 40rpx rgba(0, 0, 0, 0.15);
}
.export-progress-icon {
  font-size: 72rpx;
  line-height: 1;
  margin-bottom: 20rpx;
}
.export-progress-text {
  font-size: 30rpx;
  color: #5D4037;
  font-weight: 600;
  margin-bottom: 32rpx;
  text-align: center;
}
.progress-bar {
  width: 100%;
  height: 12rpx;
  background: #F5EFE6;
  border-radius: 6rpx;
  overflow: hidden;
  position: relative;
}
.progress-fill.determinate {
  height: 100%;
  background: linear-gradient(90deg, #FF8C42 0%, #FF6B35 100%);
  border-radius: 6rpx;
  transition: width 0.2s ease-out;
}
.progress-fill.indeterminate {
  position: absolute;
  top: 0; left: 0;
  width: 35%;
  height: 100%;
  background: linear-gradient(90deg, #FF8C42 0%, #FF6B35 100%);
  border-radius: 6rpx;
  animation: progress-indeterminate 1.4s infinite ease-in-out;
}
@keyframes progress-indeterminate {
  0%   { left: -40%; width: 40%; }
  50%  { left: 70%;  width: 30%; }
  100% { left: 100%; width: 0;  }
}
.progress-percent {
  margin-top: 16rpx;
  font-size: 26rpx;
  color: #D96A23;
  font-weight: 600;
}
.progress-percent.muted {
  color: #BCAAA4;
  font-weight: 400;
}
