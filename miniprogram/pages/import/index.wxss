.page {
  padding: 24rpx;
}

.tip-card {
  background: #FFF3E6;
  padding: 32rpx;
  border-radius: 16rpx;
  margin-bottom: 24rpx;
}

.tip-title {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: #D96A23;
  margin-bottom: 12rpx;
}

.tip-desc {
  font-size: 26rpx;
  color: #666;
  line-height: 1.6;
}

.btn-outline {
  background: #fff;
  color: #D96A23;
  font-size: 30rpx;
  border: 2rpx solid #D96A23;
  border-radius: 44rpx;
  height: 80rpx;
  line-height: 76rpx;
}

.btn-outline::after {
  border: none;
}

.file-info {
  margin: 24rpx 0;
}

.file-name {
  font-size: 28rpx;
  color: #5D4037;
}

.preview-section {
  margin: 24rpx 0;
}

.mapping-section { margin: 24rpx 0; }
.mapping-item { display: flex; align-items: center; gap: 12rpx; padding: 18rpx 24rpx; margin-bottom: 4rpx; border-radius: 8rpx; background: #FFFFFF; color: #5D4037; font-size: 24rpx; }
.mapping-arrow { color: #D96A23; }.mapping-note { margin-left: auto; color: #9D704F; font-size: 22rpx; }

.preview-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #5D4037;
  margin-bottom: 16rpx;
}

.preview-item {
  display: flex;
  align-items: center;
  background: #fff;
  padding: 20rpx 24rpx;
  border-radius: 8rpx;
  margin-bottom: 4rpx;
  font-size: 24rpx;
  color: #666;
}

.preview-type {
  width: 80rpx;
  color: #e54545;
}

.preview-date {
  flex: 1;
}

.preview-category {
  flex: 1;
}

.preview-amount {
  font-weight: 600;
  color: #5D4037;
}

.save-btn {
  background: #FF8C42;
  color: #fff;
  font-size: 34rpx;
  border-radius: 44rpx;
  height: 88rpx;
  line-height: 88rpx;
  margin-top: 24rpx;
}

.save-btn::after {
  border: none;
}

.empty-state, .done-state { display: flex; flex-direction: column; align-items: center; padding: 48rpx 0 12rpx; }
.empty-illustration { width: 160rpx; height: 128rpx; }
.empty-mark { width: 120rpx; height: 104rpx; display: flex; align-items: center; justify-content: center; border-radius: 50%; background: #FFF1D6; border: 2rpx solid #F6B84C; font-size: 48rpx; }
.done-text { margin-top: 16rpx; color: #8D6E63; font-size: 26rpx; }
