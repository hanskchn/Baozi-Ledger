.page {
  padding: 24rpx;
}

.tip-card {
  background: #FFF3E6;
  padding: 32rpx;
  border-radius: 16rpx;
  margin-bottom: 24rpx;
}

.tip-title {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: #D96A23;
  margin-bottom: 12rpx;
}

.tip-desc {
  font-size: 26rpx;
  color: #666;
  line-height: 1.6;
}

.btn-outline {
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
  background: #fff;
  color: #D96A23;
  font-size: 30rpx;
  border: 2rpx solid #D96A23;
  border-radius: 44rpx;
  height: 80rpx;
  line-height: 76rpx;
  padding: 0;
  margin: 16rpx 0;
}

.btn-outline::after {
  border: none;
}

.file-info {
  margin: 24rpx 0;
}

.file-name {
  font-size: 28rpx;
  color: #5D4037;
}

.preview-section {
  margin: 24rpx 0;
}

.mapping-section { margin: 24rpx 0; }
.mapping-item { display: flex; align-items: center; gap: 12rpx; padding: 18rpx 24rpx; margin-bottom: 4rpx; border-radius: 8rpx; background: #FFFFFF; color: #5D4037; font-size: 24rpx; }
.mapping-arrow { color: #D96A23; }.mapping-note { margin-left: auto; color: #9D704F; font-size: 22rpx; }

.preview-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #5D4037;
  margin-bottom: 16rpx;
}

.preview-item {
  display: flex;
  align-items: center;
  background: #fff;
  padding: 20rpx 24rpx;
  border-radius: 8rpx;
  margin-bottom: 4rpx;
  font-size: 24rpx;
  color: #666;
}

.preview-type {
  width: 80rpx;
  color: #e54545;
}

.preview-date {
  flex: 1;
}

.preview-category {
  flex: 1;
}

.preview-amount {
  font-weight: 600;
  color: #5D4037;
}

.save-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
  background: linear-gradient(135deg, #FF8C42 0%, #FF6B35 100%);
  color: #fff;
  font-size: 34rpx;
  font-weight: 600;
  border-radius: 44rpx;
  height: 88rpx;
  line-height: 88rpx;
  margin-top: 24rpx;
  padding: 0;
  box-shadow: 0 6rpx 18rpx rgba(255, 107, 53, 0.3);
}

.save-btn::after {
  border: none;
}

.summary-section {
  margin: 24rpx 0 12rpx;
  padding: 16rpx 24rpx;
  background: #fff;
  border-radius: 12rpx;
  border: 2rpx solid #FFD9B8;
}

.summary-row {
  display: flex;
  justify-content: space-between;
  font-size: 28rpx;
  color: #5D4037;
  padding: 6rpx 0;
}

.summary-num {
  font-weight: 600;
  color: #D96A23;
}

.summary-num.valid {
  color: #D96A23;
}

.summary-num.invalid {
  color: #C62828;
}

.invalid-section {
  margin: 24rpx 0;
  padding: 16rpx 24rpx;
  background: #FFF8F0;
  border-radius: 12rpx;
  border: 2rpx solid #FFD9B8;
}

.invalid-item {
  display: flex;
  font-size: 26rpx;
  color: #5D4037;
  line-height: 1.6;
  padding: 6rpx 0;
}

.invalid-row {
  flex: 0 0 120rpx;
  color: #D96A23;
  font-weight: 600;
}

.invalid-reason {
  flex: 1;
  color: #666;
}

.empty-state, .done-state { display: flex; flex-direction: column; align-items: center; padding: 48rpx 0 12rpx; }
.empty-illustration { width: 160rpx; height: 128rpx; }
.empty-mark { width: 120rpx; height: 104rpx; display: flex; align-items: center; justify-content: center; border-radius: 50%; background: #FFF1D6; border: 2rpx solid #F6B84C; font-size: 48rpx; }
.done-text { margin-top: 16rpx; color: #8D6E63; font-size: 26rpx; }

/* 导入进度浮层（替代系统 showLoading，避免进度文字被截断） */
.import-mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.55);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 999;
}

.import-card {
  width: 500rpx;
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 48rpx 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.15);
}

.import-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #4E342E;
}

.import-number {
  margin-top: 24rpx;
  font-size: 64rpx;
  font-weight: 700;
  color: #D96A23;
  line-height: 1.2;
}

.import-total {
  font-size: 32rpx;
  font-weight: 500;
  color: #8D6E63;
}

.import-track {
  margin-top: 24rpx;
  width: 100%;
  height: 16rpx;
  background: #F0E6DC;
  border-radius: 8rpx;
  overflow: hidden;
}

.import-bar {
  height: 100%;
  background: linear-gradient(90deg, #F6B84C, #D96A23);
  border-radius: 8rpx;
  transition: width 0.3s ease;
}

.import-percent {
  margin-top: 12rpx;
  font-size: 26rpx;
  color: #8D6E63;
}

.import-tip {
  margin-top: 28rpx;
  font-size: 24rpx;
  color: #A1887F;
}
