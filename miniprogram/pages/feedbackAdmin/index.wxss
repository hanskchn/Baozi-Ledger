.page { min-height: 100vh; background: #FFF8EC; padding: 24rpx 24rpx 60rpx; }

.filter-row { display: flex; gap: 12rpx; margin-bottom: 20rpx; }
.filter-tab {
  flex: 1;
  text-align: center;
  padding: 14rpx 0;
  font-size: 24rpx;
  border-radius: 12rpx;
  background: #fff;
  color: #8D6E63;
  border: 2rpx solid #F0E6D6;
}
.filter-tab.active { background: #FF8C42; color: #fff; border-color: #FF8C42; font-weight: 600; }
.filter-count {
  display: inline-block;
  min-width: 28rpx;
  padding: 0 8rpx;
  height: 28rpx;
  line-height: 28rpx;
  font-size: 20rpx;
  border-radius: 14rpx;
  background: #E85D5D;
  color: #fff;
  margin-left: 6rpx;
}
.filter-tab.active .filter-count { background: #fff; color: #FF8C42; }

.empty { text-align: center; padding: 120rpx 0; }
.empty-icon { font-size: 80rpx; }
.empty-text { color: #BCAAA4; font-size: 26rpx; margin-top: 16rpx; }

.admin-item { background: #fff; border-radius: 16rpx; padding: 24rpx; margin-bottom: 16rpx; box-shadow: 0 2rpx 12rpx rgba(93,64,55,0.06); }
.admin-head { display: flex; align-items: center; gap: 12rpx; margin-bottom: 12rpx; }
.admin-avatar { width: 48rpx; height: 48rpx; border-radius: 50%; background: linear-gradient(135deg,#FFB74D,#FF8C42); color: #fff; font-size: 22rpx; display: flex; align-items: center; justify-content: center; font-weight: 600; flex-shrink: 0; }
.admin-name { font-size: 26rpx; font-weight: 600; color: #5D4037; }
.admin-time { margin-left: auto; font-size: 22rpx; color: #BCAAA4; }
.admin-text { font-size: 28rpx; color: #5D4037; line-height: 1.5; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
.admin-contact { font-size: 22rpx; color: #FF8C42; margin-top: 8rpx; }
.copy-hint { margin-left: 12rpx; font-size: 20rpx; color: #BCAAA4; }
.meta-contact { color: #FF8C42; }
.admin-foot { display: flex; gap: 16rpx; margin-top: 12rpx; font-size: 22rpx; color: #BCAAA4; flex-wrap: wrap; }
.foot-item.replied { color: #4CAF50; }

.badge { font-size: 22rpx; padding: 4rpx 14rpx; border-radius: 18rpx; }
.badge-pending { background: #FFF3E0; color: #E89100; }
.badge-processing { background: #E3F2FD; color: #1976D2; }
.badge-resolved { background: #E8F5E9; color: #2E7D32; }
.badge-closed { background: #EFEBE9; color: #8D6E63; }
.fb-type { font-size: 22rpx; padding: 4rpx 14rpx; border-radius: 18rpx; background: #FFF3E6; color: #FF8C42; }
.fb-type.bug { background: #FDE0E0; color: #E85D5D; }
.fb-type.other { background: #EFEBE9; color: #8D6E63; }

.load-more { text-align: center; padding: 24rpx; color: #FF8C42; font-size: 26rpx; }
.load-end { text-align: center; padding: 24rpx; color: #BCAAA4; font-size: 24rpx; }

.mask { position: fixed; inset: 0; background: rgba(0,0,0,0.45); z-index: 100; }
.sheet {
  position: fixed;
  left: 0; right: 0; bottom: 0;
  background: #FFF8EC;
  border-radius: 28rpx 28rpx 0 0;
  z-index: 101;
  height: 85vh;
  max-height: 85vh;
  display: flex;
  flex-direction: column;
  padding-bottom: env(safe-area-inset-bottom);
  box-sizing: border-box;
  overflow: hidden;
}
.sheet-handle { width: 64rpx; height: 8rpx; background: #D9C7AF; border-radius: 4rpx; margin: 16rpx auto 0; flex-shrink: 0; }
.sheet-body {
  padding: 24rpx 32rpx;
  flex: 1;
  min-height: 0;
  height: 0;
  width: 100%;
  box-sizing: border-box;
  overflow-x: hidden;
}
.detail-head { display: flex; justify-content: space-between; align-items: center; gap: 16rpx; margin-bottom: 16rpx; }
.detail-head .fb-type { flex-shrink: 0; }
.detail-head .badge { flex-shrink: 0; }
.detail-content { font-size: 30rpx; color: #5D4037; line-height: 1.6; word-break: break-all; overflow-wrap: break-word; }
.detail-imgs { display: flex; flex-wrap: wrap; gap: 12rpx; margin-top: 16rpx; }
.detail-img { width: 160rpx; height: 160rpx; border-radius: 12rpx; }
.detail-meta { margin-top: 20rpx; font-size: 24rpx; color: #8D6E63; line-height: 1.8; background: #fff; padding: 16rpx 20rpx; border-radius: 12rpx; }
.reply-box { margin-top: 20rpx; background: #fff; border-left: 6rpx solid #FF8C42; border-radius: 8rpx; padding: 16rpx; }
.reply-label { font-size: 22rpx; color: #FF8C42; font-weight: 600; }
.reply-text { font-size: 26rpx; color: #5D4037; line-height: 1.5; margin-top: 6rpx; word-break: break-all; overflow-wrap: break-word; }

.form-label { font-size: 26rpx; color: #8D6E63; margin: 24rpx 0 12rpx; }
.reply-input { width: 100%; min-height: 160rpx; background: #fff; border-radius: 12rpx; padding: 20rpx; font-size: 28rpx; box-sizing: border-box; }
.placeholder { color: #BCAAA4; }
.status-row { display: flex; gap: 12rpx; flex-wrap: wrap; }
.status-chip { padding: 12rpx 24rpx; border-radius: 24rpx; border: 2rpx solid #F0E6D6; background: #fff; font-size: 24rpx; color: #5D4037; }
.status-chip.active { border-color: #FF8C42; background: #FFF3E6; color: #FF6B35; font-weight: 600; }

.sheet-actions { display: flex; gap: 16rpx; padding: 16rpx 32rpx 24rpx; flex-shrink: 0; }
.btn-cancel, .btn-save { flex: 1; height: 80rpx; line-height: 80rpx; border-radius: 40rpx; font-size: 28rpx; padding: 0; }
.btn-cancel { background: #fff; color: #8D6E63; border: 2rpx solid #F0E6D6; }
.btn-save { background: #FF8C42; color: #fff; font-weight: 600; }
