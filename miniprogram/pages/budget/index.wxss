.page {
  padding: 24rpx;
}

.month-bar { display: flex; align-items: center; justify-content: center; padding: 20rpx 0; color: #D96A23; font-size: 36rpx; }
.month-bar text { padding: 0 44rpx; }.month-text { min-width: 180rpx; text-align: center; color: #5D4037; font-size: 30rpx; font-weight: 600; }

.budget-card {
  background: #fff;
  padding: 40rpx 32rpx;
  border-radius: 16rpx;
  margin-bottom: 16rpx;
}

.budget-label {
  font-size: 28rpx;
  color: #999;
}

.budget-input-row {
  display: flex;
  align-items: center;
  margin-top: 16rpx;
}

.budget-symbol {
  font-size: 48rpx;
  font-weight: 600;
  color: #5D4037;
  margin-right: 16rpx;
}

.budget-input {
  flex: 1;
  font-size: 56rpx;
  font-weight: 600;
  color: #5D4037;
}

.status-card {
  background: #fff;
  padding: 32rpx;
  border-radius: 16rpx;
  margin-bottom: 32rpx;
}

.status-row {
  display: flex;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.status-label {
  font-size: 28rpx;
  color: #666;
}

.status-value {
  font-size: 32rpx;
  font-weight: 600;
}

.status-value.expense {
  color: #e54545;
}

.progress-bar {
  height: 16rpx;
  background: #F5EBDD;
  border-radius: 8rpx;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  background: #FF8C42;
  border-radius: 8rpx;
  transition: width 0.3s;
}

.progress-fill.over {
  background: #e54545;
}

.status-tip {
  font-size: 26rpx;
  color: #999;
  margin-top: 16rpx;
}

.status-tip.warning { color: #D96A23; }
.status-tip.over { color: #E54545; }

.save-btn {
  background: #FF8C42;
  color: #fff;
  font-size: 34rpx;
  border-radius: 44rpx;
  height: 88rpx;
  line-height: 88rpx;
}

.save-btn::after {
  border: none;
}

.delete-btn { margin-top: 20rpx; background: #FFF0EB; color: #FF6B35; font-size: 28rpx; border-radius: 44rpx; }
