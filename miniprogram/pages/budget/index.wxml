<view class="page">
  <view class="month-bar"><text data-delta="-1" bindtap="switchMonth">‹</text><text class="month-text">{{month}}</text><text data-delta="1" bindtap="switchMonth">›</text></view>
  <view class="budget-card">
    <text class="budget-label">本月预算</text>
    <view class="budget-input-row">
      <text class="budget-symbol">¥</text>
      <input class="budget-input" type="digit" placeholder="0.00" value="{{monthBudget}}" bindinput="onBudgetInput" />
    </view>
  </view>

  <view class="status-card">
    <view class="status-row">
      <text class="status-label">已支出</text>
      <text class="status-value expense">¥{{monthExpense}}</text>
    </view>
    <view class="progress-bar">
      <view class="progress-fill {{percent > 100 ? 'over' : ''}}" style="width: {{percent > 100 ? 100 : percent}}%"></view>
    </view>
    <view class="status-tip over" wx:if="{{percent >= 100}}">本月支出已超出预算 {{percent - 100}}%</view>
    <view class="status-tip warning" wx:elif="{{percent >= 80}}">本月预算已使用 {{percent}}%，请留意支出</view>
    <view class="status-tip" wx:elif="{{hasBudget}}">已使用 {{percent}}%</view>
    <view class="status-tip" wx:else>尚未设置本月预算</view>
  </view>

  <button class="save-btn" bindtap="saveBudget">保存</button>
  <button class="delete-btn" wx:if="{{hasBudget}}" bindtap="deleteBudget">删除本月预算</button>
</view>
