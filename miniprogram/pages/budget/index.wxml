<view class="page">
  <view class="month-bar">
    <view class="month-arrow" data-delta="-1" bindtap="switchMonth">‹</view>
    <picker mode="date" fields="month" value="{{month}}" bindchange="onMonthPickerChange">
      <view class="month-picker">
        <text class="month-text">{{monthLabel}}</text>
        <text wx:if="{{isCurrentMonth}}" class="month-badge">本月</text>
      </view>
    </picker>
    <view class="month-arrow" data-delta="1" bindtap="switchMonth">›</view>
  </view>

  <view class="budget-card">
    <text class="card-label">本月预算</text>
    <view class="budget-input-row" wx:if="{{isAdmin}}">
      <text class="budget-symbol">¥</text>
      <input class="budget-input" type="digit" placeholder="0.00" placeholder-class="budget-placeholder" value="{{budgetAmount}}" bindinput="onBudgetInput" focus="{{false}}" />
    </view>
    <view class="budget-display" wx:else>
      <text class="budget-symbol">¥</text>
      <text class="budget-amount-text">{{hasBudget ? budgetAmount : '未设置'}}</text>
    </view>
  </view>

  <view class="status-card">
    <view class="status-grid">
      <view class="status-item">
        <text class="status-item-label">已支出</text>
        <text class="status-item-value expense">¥{{monthExpense}}</text>
      </view>
      <view class="status-divider"></view>
      <view class="status-item">
        <text class="status-item-label">{{percent >= 100 ? '已超支' : '剩余'}}</text>
        <text class="status-item-value {{percent >= 100 ? 'over' : 'remain'}}">¥{{remain}}</text>
      </view>
      <view class="status-divider"></view>
      <view class="status-item">
        <text class="status-item-label">使用率</text>
        <text class="status-item-value {{percent >= 100 ? 'over' : (percent >= 80 ? 'warning' : '')}}">{{percent}}%</text>
      </view>
    </view>
    <view class="progress-bar">
      <view class="progress-fill {{percent >= 100 ? 'over' : (percent >= 80 ? 'warning' : '')}}" style="width: {{percent > 100 ? 100 : percent}}%"></view>
    </view>
    <view class="status-tip over" wx:if="{{hasBudget && percent >= 100}}">本月支出已超出预算 {{percent - 100}}%</view>
    <view class="status-tip warning" wx:elif="{{hasBudget && percent >= 80}}">本月预算已使用 {{percent}}%，请留意支出</view>
    <view class="status-tip future" wx:elif="{{isFutureMonth && hasBudget}}">预算已设置，将在该月生效</view>
    <view class="status-tip" wx:elif="{{hasBudget}}">已使用 {{percent}}%</view>
    <view class="status-tip muted" wx:elif="{{isAdmin}}">尚未设置本月预算</view>
    <view class="status-tip muted" wx:else>管理员尚未设置本月预算</view>
  </view>

  <view wx:if="{{isAdmin}}" class="quick-actions">
    <view class="quick-btn copy {{canCopyPrev ? '' : 'disabled'}}" bindtap="copyPrevBudget">
      <text class="quick-icon">📋</text>
      <text>{{canCopyPrev ? '复制上月预算' : '上月未设置预算'}}</text>
    </view>
    <view wx:if="{{hasBudget}}" class="quick-btn delete" bindtap="deleteBudget">
      <text class="quick-icon">🗑️</text>
      <text>删除本月预算</text>
    </view>
  </view>

  <button wx:if="{{isAdmin}}" class="save-btn {{budgetAmount && budgetAmount !== savedAmount && Number(budgetAmount) > 0 ? '' : 'disabled'}}" disabled="{{!budgetAmount || budgetAmount === savedAmount || Number(budgetAmount) <= 0}}" bindtap="saveBudget">保存</button>
</view>
