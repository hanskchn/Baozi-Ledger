.page {
  padding: 24rpx;
}

.account-item {
  display: flex;
  align-items: center;
  background: #fff;
  padding: 28rpx 32rpx;
  border-radius: 12rpx;
  margin-bottom: 12rpx;
}

.account-icon {
  font-size: 36rpx;
  margin-right: 20rpx;
}

.account-name {
  flex: 1;
  font-size: 30rpx;
  color: #5D4037;
}

.account-action {
  font-size: 26rpx;
  color: #9D704F;
}

.account-edit { font-size: 26rpx; color: #D96A23; margin-right: 24rpx; }
.is-disabled { opacity: .52; }

.empty-tip {
  text-align: center;
  color: #bbb;
  font-size: 28rpx;
  padding: 80rpx 0;
}

.btn-outline {
  background: #fff;
  color: #D96A23;
  font-size: 30rpx;
  border: 2rpx solid #D96A23;
  border-radius: 44rpx;
  height: 80rpx;
  line-height: 76rpx;
  margin-top: 16rpx;
}

.btn-outline::after {
  border: none;
}
