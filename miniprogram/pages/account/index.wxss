.page {
  padding: 24rpx;
}

.account-item {
  display: flex;
  align-items: center;
  background: #fff;
  padding: 28rpx 32rpx;
  border-radius: 12rpx;
  margin-bottom: 12rpx;
}

.account-icon {
  font-size: 36rpx;
  margin-right: 20rpx;
}

.account-name {
  flex: 1;
  font-size: 30rpx;
  color: #333;
}

.account-delete {
  font-size: 26rpx;
  color: #e54545;
}

.empty-tip {
  text-align: center;
  color: #bbb;
  font-size: 28rpx;
  padding: 80rpx 0;
}

.btn-outline {
  background: #fff;
  color: #07C160;
  font-size: 30rpx;
  border: 2rpx solid #07C160;
  border-radius: 44rpx;
  height: 80rpx;
  line-height: 76rpx;
  margin-top: 16rpx;
}

.btn-outline::after {
  border: none;
}
