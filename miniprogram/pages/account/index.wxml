<view class="page">
  <view class="account-list">
    <view class="empty-tip" wx:if="{{accounts.length === 0}}">暂无账户，请添加</view>
    <view class="account-item {{item.enabled === false ? 'is-disabled' : ''}}" wx:for="{{accounts}}" wx:key="id">
      <text class="account-icon">💳</text>
      <text class="account-name">{{item.name}}</text>
      <text class="account-edit" data-id="{{item.id}}" bindtap="editAccount">编辑</text>
      <text class="account-action" data-id="{{item.id}}" data-enabled="{{item.enabled !== false}}" bindtap="toggleAccount">{{item.enabled === false ? '恢复' : '停用'}}</text>
    </view>
  </view>
  <button class="btn-outline" bindtap="addAccount">+ 添加账户</button>
<privacy-popup />
</view>
