.page {
  padding: 24rpx 0 40rpx;
}

.warn-banner {
  margin: 0 24rpx 24rpx;
  padding: 20rpx 24rpx;
  border-radius: 12rpx;
  background: #FFF3E0;
  color: #E65100;
  font-size: 26rpx;
  line-height: 1.5;
}

.card {
  margin: 0 24rpx;
  background: #FFFFFF;
  border-radius: 16rpx;
  overflow: hidden;
}

.card-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 32rpx 12rpx;
}

.card-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #5D4037;
}

.refresh {
  font-size: 26rpx;
  color: #FF8C42;
}

.row {
  display: flex;
  align-items: center;
  padding: 28rpx 32rpx;
  border-top: 1rpx solid #F5EBE0;
}

.row-main {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.row-label {
  font-size: 30rpx;
  color: #5D4037;
}

.row-desc {
  margin-top: 6rpx;
  font-size: 24rpx;
  color: #BCAAA4;
}

.row-right {
  display: flex;
  align-items: center;
}

.row-count {
  margin-right: 20rpx;
  padding: 2rpx 14rpx;
  border-radius: 20rpx;
  background: #F5EBE0;
  font-size: 22rpx;
  color: #8D6E63;
}

.row-go {
  font-size: 26rpx;
  color: #FF8C42;
}

.row.danger .row-label {
  color: #D64545;
  font-weight: 600;
}

.row.danger .row-go {
  color: #D64545;
}

/* 每日记账提醒调试卡片 */
.remind-card {
  margin-top: 24rpx;
}

.remind-actions {
  display: flex;
  gap: 20rpx;
  padding: 16rpx 32rpx;
}

.remind-btn {
  flex: 1;
  margin: 0;
  padding: 0;
  height: 72rpx;
  line-height: 70rpx;
  font-size: 26rpx;
  color: #FFFFFF;
  background: #FF8C42;
  border-radius: 36rpx;
}
.remind-btn::after {
  border: none;
}
.remind-btn.warn {
  background: #D64545;
}
.remind-btn[disabled] {
  opacity: 0.6;
}

.remind-skip {
  display: flex;
  align-items: center;
  padding: 8rpx 32rpx 24rpx;
}
.remind-skip-text {
  margin-left: 16rpx;
  font-size: 26rpx;
  color: #8D6E63;
}

.kv {
  display: flex;
  align-items: baseline;
  padding: 18rpx 32rpx;
  border-top: 1rpx solid #F5EBE0;
}
.kv-label {
  width: 220rpx;
  flex-shrink: 0;
  font-size: 24rpx;
  color: #BCAAA4;
}
.kv-value {
  flex: 1;
  font-size: 26rpx;
  line-height: 38rpx;
  word-break: break-all;
  color: #5D4037;
}
.kv-value.ok {
  font-weight: 600;
  color: #FF8C42;
}

.remind-empty {
  padding: 40rpx 32rpx;
  border-top: 1rpx solid #F5EBE0;
  font-size: 26rpx;
  color: #BCAAA4;
}
