<view class="page">
  <view class="warn-banner">仅开发者可用，清除操作不可恢复，请谨慎操作。</view>

  <view class="card">
    <view class="card-head">
      <text class="card-title">数据清除</text>
      <text class="refresh" bindtap="loadCounts">↻ 刷新</text>
    </view>
    <view wx:for="{{options}}" wx:key="key" class="row {{item.danger ? 'danger' : ''}}" data-key="{{item.key}}" bindtap="onClear">
      <view class="row-main">
        <text class="row-label">{{item.label}}</text>
        <text class="row-desc">{{item.desc}}</text>
      </view>
      <view class="row-right">
        <text wx:if="{{item.counts.length}}" class="row-count">{{item.counts}}</text>
        <text class="row-go">清除</text>
      </view>
    </view>
  </view>

  <!-- 每日记账提醒 调试 -->
  <view class="card remind-card">
    <view class="card-head">
      <text class="card-title">每日记账提醒</text>
      <text class="refresh" bindtap="loadReminderDebug">↻ 刷新诊断</text>
    </view>

    <view class="remind-actions">
      <button class="remind-btn" bindtap="requestReminderAuth" disabled="{{reminderBusy}}">补充一条推送额度</button>
      <button class="remind-btn warn" bindtap="sendTestReminder">立即发测试消息</button>
    </view>
    <view class="remind-skip">
      <switch checked="{{skipRecordedCheck}}" color="#FF8C42" bindchange="onToggleSkipRecorded" />
      <text class="remind-skip-text">跳过「今日已记账」判断</text>
    </view>

    <block wx:if="{{reminderDebug}}">
      <view wx:for="{{reminderDebug}}" wx:key="index" class="kv">
        <text class="kv-label">{{item.label}}</text>
        <text class="kv-value {{item.ok ? 'ok' : ''}}">{{item.value}}</text>
      </view>
    </block>
    <view wx:else class="remind-empty" bindtap="loadReminderDebug">点击「刷新诊断」查看当前状态与是否将发送的判定</view>
  </view>
  <privacy-popup />
</view>
