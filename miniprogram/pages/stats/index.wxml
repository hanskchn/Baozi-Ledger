<view class="page">
  <view class="top-bar">
    <view class="period-nav">
      <view class="period-arrow {{periodMode !== 'month' ? 'is-muted' : ''}}" data-delta="-1" bindtap="changePeriod">‹</view>
      <view class="period-picker" bindtap="openTimeSheet">
        <text class="period-label">{{displayMonth}}</text>
        <text class="period-caret">▾</text>
      </view>
      <view class="period-arrow {{periodMode !== 'month' ? 'is-muted' : ''}}" data-delta="1" bindtap="changePeriod">›</view>
    </view>
  </view>

  <view class="summary-card"><view class="summary-item"><text class="summary-label">支出</text><text class="summary-value expense">¥{{monthExpense}}</text></view><view class="summary-item"><text class="summary-label">收入</text><text class="summary-value income">¥{{monthIncome}}</text></view><view class="summary-item"><text class="summary-label">结余</text><text class="summary-value">¥{{monthBalance}}</text></view></view>
  <view class="stats-filters">
    <picker class="stats-filter-picker" mode="selector" range="{{memberOptions}}" value="{{memberPickerIndex}}" bindchange="onMemberChange">
      <text class="stats-filter {{filterMember ? 'active' : ''}}">{{filterMemberLabel || '全部成员'}} ▾</text>
    </picker>
    <picker class="stats-filter-picker" mode="selector" range="{{accountOptions}}" value="{{accountPickerIndex}}" bindchange="onAccountChange">
      <text class="stats-filter {{filterAccount ? 'active' : ''}}">{{filterAccount || '全部账户'}} ▾</text>
    </picker>
  </view>
  <view hidden="{{showTimeSheet}}"><view class="chart-tabs">
    <view class="chart-tab {{chartType === 'expense' ? 'active' : ''}}" data-type="expense" bindtap="switchChartType">支出分类</view>
    <view class="chart-tab {{chartType === 'income' ? 'active' : ''}}" data-type="income" bindtap="switchChartType">收入分类</view>
  </view>
  <view class="chart-mode-tabs">
    <view class="chart-mode-tab {{chartMode === 'pie' ? 'active' : ''}}" data-mode="pie" bindtap="switchChartMode">饼图</view>
    <view class="chart-mode-tab {{chartMode === 'bar' ? 'active' : ''}}" data-mode="bar" bindtap="switchChartMode">条形图</view>
  </view>
  <view class="chart-card">
  <view class="chart-title">分类占比<text wx:if="{{categoryStats.length > 0 && chartMode === 'pie'}}" class="chart-tip">点击查看明细</text></view>
  <view wx:if="{{loading && categoryStats.length === 0}}" class="chart-skeleton chart-skeleton-row">
    <view class="skeleton-pie"></view>
    <view class="skeleton-legend">
      <view class="skeleton-row"></view>
      <view class="skeleton-row"></view>
      <view class="skeleton-row"></view>
      <view class="skeleton-row"></view>
    </view>
  </view>
  <view wx:if="{{categoryStats.length === 0 && !loading}}" class="empty-tip">当前范围暂无{{chartType === 'expense' ? '支出' : '收入'}}数据</view>

  <!-- 饼图 + 右侧图例（并排） -->
  <view wx:if="{{categoryStats.length > 0 && chartMode === 'pie'}}" class="chart-body">
    <view class="chart-pie">
      <pie-chart id="pieChart" slices="{{categorySlicesForChart}}" title="{{chartType === 'expense' ? '总支出' : '总收入'}}" category-count="{{categoryStats.length}}" scheme="{{chartType}}" bindtap="onPieTap" />
    </view>
    <scroll-view scroll-y class="chart-legend">
      <view class="legend-inner">
        <view class="legend-header">
          <text class="legend-count">共 {{categoryStats.length}} 项</text>
        </view>
        <view wx:for="{{categoryStats}}" wx:key="name" class="legend-item" data-name="{{item.name}}" data-color="{{item.color}}" bindtap="onCategoryTap" hover-class="legend-item-hover" hover-stay-time="80">
          <view class="legend-color" style="background-color: {{item.color}}"></view>
          <text class="legend-name">{{item.name}}</text>
          <text class="legend-amount">¥{{item.displayAmount}}</text>
          <text class="legend-percent">{{item.percent}}%</text>
        </view>
        <view class="legend-fade"></view>
      </view>
    </scroll-view>
  </view>

  <!-- 列表模式 -->
  <view wx:if="{{categoryStats.length > 0 && chartMode === 'bar'}}" class="rank-list">
    <view wx:for="{{categoryStats}}" wx:key="name" class="rank-item" data-name="{{item.name}}" bindtap="onCategoryTap" hover-class="rank-item-hover" hover-stay-time="80">
      <text class="rank-icon">{{item.icon || '📝'}}</text>
      <view class="rank-main">
        <view class="rank-text">
          <text>{{item.name}}</text>
          <text>¥{{item.displayAmount}}</text>
        </view>
        <view class="rank-track">
          <view class="rank-fill {{chartType}}" style="width: {{item.percent}}%"></view>
        </view>
      </view>
      <text class="rank-percent">{{item.percent}}% ›</text>
    </view>
  </view>
</view>
  <view class="chart-card">
    <view class="chart-title">
      <text>收支趋势</text>
      <text class="chart-tip">{{trendGranularity === 'day' ? '按日' : trendGranularity === 'month' ? '按月' : '按年'}}</text>
    </view>
    <view class="trend-card-body">
      <view wx:if="{{loading && dailyTrend.length === 0}}" class="chart-skeleton"><view class="skeleton-trend"></view></view>
      <view wx:elif="{{dailyTrend.length === 0}}" class="empty-tip">当前范围暂无账单</view>
      <view wx:else class="trend-chart-wrap"><trend-chart id="trendChart" data="{{dailyTrend}}" smooth="{{trendSmooth}}" /></view>
    </view>
  </view>
</view>

  <!-- 时间选择弹层 -->
  <view class="time-sheet-mask" wx:if="{{showTimeSheet}}" bindtap="closeTimeSheet"></view>
  <view class="time-sheet" wx:if="{{showTimeSheet}}" catchtap="stopPropagation">
    <view class="time-sheet-header">
      <text class="time-sheet-title">选择时间</text>
      <text class="time-sheet-close" bindtap="closeTimeSheet">✕</text>
    </view>
    <scroll-view scroll-y class="time-sheet-body">
      <view class="quick-grid">
        <view class="quick-chip {{quick === 'thisMonth' ? 'active' : ''}}" data-key="thisMonth" bindtap="selectQuick">本月</view>
        <view class="quick-chip {{quick === 'lastMonth' ? 'active' : ''}}" data-key="lastMonth" bindtap="selectQuick">上月</view>
        <view class="quick-chip {{quick === 'thisYear' ? 'active' : ''}}" data-key="thisYear" bindtap="selectQuick">今年</view>
        <view class="quick-chip {{quick === 'all' ? 'active' : ''}}" data-key="all" bindtap="selectQuick">全部</view>
      </view>
      <view class="time-section">
        <view class="time-section-head">
          <text class="quick-chip small {{quick === 'custom' && timeMode === 'month' ? 'active' : ''}}" data-key="customMonth" bindtap="selectQuick">选择月份</text>
        </view>
        <picker wx:if="{{timeMode === 'month'}}" mode="date" fields="month" value="{{tempMonth}}" bindchange="onTempMonthChange">
          <view class="picker-field">{{tempMonth || '请选择月份'}}</view>
        </picker>
      </view>
      <view class="time-section">
        <view class="time-section-head">
          <text class="quick-chip small {{quick === 'custom' && timeMode === 'range' ? 'active' : ''}}" data-key="customRange" bindtap="selectQuick">自定义范围</text>
        </view>
        <view wx:if="{{timeMode === 'range'}}" class="range-row">
          <picker mode="date" value="{{tempDateStart}}" bindchange="onTempStartChange">
            <view class="picker-field">{{tempDateStart || '开始日期'}}</view>
          </picker>
          <text class="range-sep">至</text>
          <picker mode="date" value="{{tempDateEnd}}" start="{{tempDateStart}}" bindchange="onTempEndChange">
            <view class="picker-field">{{tempDateEnd || '结束日期'}}</view>
          </picker>
        </view>
      </view>
    </scroll-view>
  </view>
</view>
