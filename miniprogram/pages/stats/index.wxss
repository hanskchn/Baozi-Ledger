.page { min-height: 100vh; padding: 0 0 40rpx; background: #FFF8EC; }
.top-bar {
  position: sticky;
  top: 0;
  z-index: 100;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 24rpx;
  background: #FFFFFF;
}
.top-bar::before {
  content: "";
  position: absolute;
  left: 0;
  right: 0;
  top: -100rpx;
  height: 100rpx;
  background: #FFFFFF;
}
.top-bar::after {
  content: "";
  position: absolute;
  left: 0;
  right: 0;
  bottom: -20rpx;
  height: 20rpx;
  background: #FFFFFF;
}
.period-nav { display: flex; align-items: center; }
.period-arrow { width: 56rpx; height: 56rpx; line-height: 52rpx; text-align: center; font-size: 36rpx; color: #FF8C42; background: #FFF3E6; border-radius: 50%; }
.period-arrow.is-muted { color: #D7C9BC; }
.period-picker { display: flex; align-items: center; padding: 0 16rpx; min-width: 240rpx; justify-content: center; }
.period-label { font-size: 30rpx; font-weight: 600; color: #5D4037; }
.period-caret { margin-left: 6rpx; font-size: 20rpx; color: #FF8C42; }
.summary-card { display: flex; margin: 20rpx 24rpx; padding: 30rpx 0; background: #FFFFFF; border-radius: 20rpx; box-shadow: 0 4rpx 16rpx rgba(93,64,55,.08); }
.summary-item { flex: 1; display: flex; flex-direction: column; align-items: center; }
.stats-filters { display: flex; gap: 12rpx; padding: 0 24rpx; overflow: hidden; }.stats-filter-picker { flex: 1; min-width: 0; }.stats-filter { display: block; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; padding: 14rpx 12rpx; border-radius: 8rpx; background: #FFF3E6; color: #8D6E63; font-size: 24rpx; text-align: center; }.stats-filter.active { color: #D96A23; }
.summary-label { color: #8D6E63; font-size: 24rpx; }.summary-value { margin-top: 12rpx; color: #5D4037; font-size: 30rpx; font-weight: 600; }.summary-value.expense { color: #FF6B35; }.summary-value.income { color: #4CAF50; }
.chart-tabs { display: flex; margin: 24rpx 24rpx 0; padding: 6rpx; border-radius: 14rpx; background: #F5EDE2; }.chart-tab { flex: 1; padding: 16rpx 0; border-radius: 10rpx; text-align: center; color: #8D6E63; font-size: 28rpx; }.chart-tab.active { background: #FFFFFF; color: #FF8C42; font-weight: 600; }
.chart-mode-tabs { display: flex; justify-content: flex-end; gap: 8rpx; padding: 12rpx 36rpx 0; }
.chart-mode-tab { padding: 6rpx 20rpx; font-size: 24rpx; color: #A58D80; background: transparent; border-radius: 24rpx; }
.chart-mode-tab.active { background: #F5EDE2; color: #FF8C42; font-weight: 600; }
.chart-card { position: relative; margin: 18rpx 24rpx; padding: 28rpx; border-radius: 20rpx; background: #FFFFFF; box-shadow: 0 4rpx 16rpx rgba(93,64,55,.08); overflow: hidden; }.chart-title { display: flex; align-items: baseline; justify-content: space-between; margin-bottom: 18rpx; color: #5D4037; font-size: 30rpx; font-weight: 600; }.chart-tip { font-size: 22rpx; font-weight: 400; color: #BCAAA4; }
.rank-item { display: flex; align-items: center; padding: 16rpx 0; }.rank-item-hover { opacity: .6; }.rank-icon { width: 46rpx; font-size: 32rpx; }.rank-main { flex: 1; margin: 0 14rpx; }.rank-text { display: flex; justify-content: space-between; color: #5D4037; font-size: 24rpx; }.rank-track { height: 12rpx; margin-top: 12rpx; border-radius: 6rpx; overflow: hidden; background: #F5EFE6; }.rank-fill { height: 100%; border-radius: 6rpx; background: #FF6B35; }.rank-fill.income { background: #4CAF50; }.rank-percent { min-width: 90rpx; color: #BCAAA4; font-size: 22rpx; text-align: right; }
.chart-canvas { width: 100%; }
.pie-canvas { height: 390rpx; }
.bar-canvas { height: 420rpx; }
.empty-tip { padding: 64rpx 0; text-align: center; color: #BCAAA4; font-size: 26rpx; }
.chart-skeleton { display: flex; gap: 24rpx; align-items: center; padding: 10rpx 0; }
.skeleton-pie { width: 280rpx; height: 280rpx; border-radius: 50%; background: linear-gradient(100deg, #F5EDE2 20%, #FFF 50%, #F5EDE2 80%); background-size: 200% 100%; animation: skeleton-shimmer 1.2s infinite; }
.skeleton-rank { flex: 1; display: flex; flex-direction: column; gap: 18rpx; }
.skeleton-row { height: 28rpx; border-radius: 14rpx; background: linear-gradient(100deg, #F5EDE2 20%, #FFF 50%, #F5EDE2 80%); background-size: 200% 100%; animation: skeleton-shimmer 1.2s infinite; }
.skeleton-trend { width: 100%; height: 260rpx; border-radius: 12rpx; background: linear-gradient(100deg, #F5EDE2 20%, #FFF 50%, #F5EDE2 80%); background-size: 200% 100%; animation: skeleton-shimmer 1.2s infinite; }
@keyframes skeleton-shimmer { 0% { background-position: 200% 0; } 100% { background-position: -200% 0; } }

/* 自定义日期范围弹层 */
.date-range-mask {
  position: fixed;
  left: 0; top: 0; right: 0; bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 200;
}
.date-range-sheet {
  position: fixed;
  left: 0; right: 0; bottom: 0;
  background: #fff;
  border-radius: 24rpx 24rpx 0 0;
  z-index: 201;
  padding-bottom: env(safe-area-inset-bottom);
}
.date-range-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 28rpx 32rpx;
  border-bottom: 1rpx solid #F5EFE6;
}
.date-range-cancel {
  font-size: 28rpx;
  color: #999;
  padding: 0 8rpx;
}
.date-range-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #5D4037;
}
.date-range-confirm {
  font-size: 28rpx;
  color: #D96A23;
  font-weight: 600;
  padding: 0 8rpx;
}
.date-range-body {
  padding: 32rpx;
}
.date-range-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 24rpx;
  background: #FFF8EC;
  border-radius: 16rpx;
  margin-bottom: 24rpx;
}
.date-range-row:last-child {
  margin-bottom: 0;
}
.date-range-label {
  font-size: 28rpx;
  color: #8D6E63;
}
.date-range-value {
  font-size: 30rpx;
  font-weight: 600;
  color: #5D4037;
}

/* 时间选择弹层 */
.time-sheet-mask {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0, 0, 0, .4);
  z-index: 200;
}
.time-sheet {
  position: fixed;
  left: 0; right: 0; top: 40vh; bottom: 0;
  background: #FFF8EC;
  border-radius: 24rpx 24rpx 0 0;
  z-index: 201;
  padding-bottom: env(safe-area-inset-bottom);
  display: flex;
  flex-direction: column;
}
.time-sheet-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 32rpx;
  flex-shrink: 0;
}
.time-sheet-title { font-size: 32rpx; font-weight: 600; color: #5D4037; }
.time-sheet-close { font-size: 36rpx; color: #B0A094; padding: 0 8rpx; }
.time-sheet-body { flex: 1; min-height: 0; height: 0; padding: 0 32rpx 32rpx; }
.quick-grid { display: flex; flex-wrap: wrap; gap: 16rpx; margin-bottom: 24rpx; }
.quick-chip {
  min-width: 140rpx;
  padding: 18rpx 28rpx;
  text-align: center;
  font-size: 28rpx;
  color: #8D6E63;
  background: #FFFFFF;
  border-radius: 36rpx;
}
.quick-chip.small { min-width: auto; padding: 12rpx 28rpx; font-size: 26rpx; }
.quick-chip.active { background: linear-gradient(135deg, #FF8C42 0%, #FF6B35 100%); color: #fff; font-weight: 600; }
.time-section { background: #FFFFFF; border-radius: 16rpx; padding: 20rpx 24rpx; margin-bottom: 20rpx; }
.time-section-head { margin-bottom: 16rpx; }
.picker-field {
  display: block;
  padding: 20rpx 32rpx;
  background: #FFF3E6;
  border-radius: 12rpx;
  font-size: 30rpx;
  color: #5D4037;
  text-align: center;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.range-row { display: flex; align-items: center; gap: 16rpx; }
.range-row picker { flex: 1; min-width: 0; }
.range-sep { font-size: 26rpx; color: #B0A094; flex-shrink: 0; width: 40rpx; text-align: center; }

/* ===== 饼图 + 图例 并排布局 ===== */
.chart-skeleton-row { padding: 10rpx 0; }
.chart-body {
  display: flex;
  align-items: flex-start;
  overflow: hidden;
}
.chart-pie {
  width: 300rpx;
  margin-right: 16rpx;
  flex-shrink: 0;
}
.chart-legend {
  width: 378rpx;
  height: 380rpx;
  max-height: 380rpx;
  box-sizing: border-box;
  overflow: hidden;
}
.legend-inner {
  width: 100%;
  box-sizing: border-box;
  overflow: hidden;
}
.legend-header {
  display: flex;
  justify-content: flex-end;
  padding: 0 4rpx 8rpx;
}
.legend-count {
  font-size: 22rpx;
  color: #A58D80;
}
.legend-item {
  display: flex;
  align-items: center;
  padding: 8rpx 4rpx;
  border-radius: 8rpx;
}
.legend-item-hover {
  background: #FFF1E8;
}
.legend-color {
  width: 12rpx;
  height: 12rpx;
  border-radius: 3rpx;
  margin-right: 8rpx;
  flex-shrink: 0;
}
.legend-name {
  flex: 1;
  min-width: 0;
  font-size: 26rpx;
  color: #5D4037;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.legend-amount {
  width: 120rpx;
  flex-shrink: 0;
  padding-left: 8rpx;
  font-size: 22rpx;
  color: #FF6B35;
  text-align: left;
  white-space: nowrap;
}
.legend-percent {
  width: 56rpx;
  flex-shrink: 0;
  padding-left: 8rpx;
  font-size: 22rpx;
  color: #A58D80;
  text-align: right;
}
/* 底部渐变蒙层，提示下面还有 */
.legend-fade {
  position: sticky;
  bottom: 0;
  left: 0;
  width: 100%;
  height: 30rpx;
  margin-top: -30rpx;
  background: linear-gradient(to bottom, rgba(255, 255, 255, 0), #FFFFFF);
  pointer-events: none;
}
.skeleton-legend {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 18rpx;
  padding-top: 8rpx;
}
