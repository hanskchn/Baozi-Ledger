.page { min-height: 100vh; padding: 0 0 40rpx; background: #FFF8EC; }
.month-bar { display: flex; align-items: center; justify-content: center; padding: 24rpx; background: #FFFFFF; }
.month-arrow { padding: 0 48rpx; color: #FF8C42; font-size: 40rpx; }
.month-arrow.is-muted { color: #D7C9BC; }
.month-text { min-width: 220rpx; text-align: center; color: #5D4037; font-size: 32rpx; font-weight: 600; }
.summary-card { display: flex; margin: 20rpx 24rpx; padding: 30rpx 0; background: #FFFFFF; border-radius: 20rpx; box-shadow: 0 4rpx 16rpx rgba(93,64,55,.08); }
.summary-item { flex: 1; display: flex; flex-direction: column; align-items: center; }
.stats-filters { display: flex; gap: 12rpx; padding: 0 24rpx; overflow: hidden; }.stats-filter-picker { flex: 1; min-width: 0; }.stats-filter { display: block; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; padding: 14rpx 12rpx; border-radius: 8rpx; background: #FFF3E6; color: #8D6E63; font-size: 24rpx; text-align: center; }.stats-filter.active { color: #D96A23; }
.summary-label { color: #8D6E63; font-size: 24rpx; }.summary-value { margin-top: 12rpx; color: #5D4037; font-size: 30rpx; font-weight: 600; }.summary-value.expense { color: #FF6B35; }.summary-value.income { color: #4CAF50; }
.chart-tabs { display: flex; margin: 24rpx 24rpx 0; padding: 6rpx; border-radius: 14rpx; background: #F5EDE2; }.chart-tab { flex: 1; padding: 16rpx 0; border-radius: 10rpx; text-align: center; color: #8D6E63; font-size: 28rpx; }.chart-tab.active { background: #FFFFFF; color: #FF8C42; font-weight: 600; }
.chart-card { margin: 18rpx 24rpx; padding: 28rpx; border-radius: 20rpx; background: #FFFFFF; box-shadow: 0 4rpx 16rpx rgba(93,64,55,.08); }.chart-title { display: flex; align-items: baseline; justify-content: space-between; margin-bottom: 18rpx; color: #5D4037; font-size: 30rpx; font-weight: 600; }.chart-tip { font-size: 22rpx; font-weight: 400; color: #BCAAA4; }
.rank-item { display: flex; align-items: center; padding: 16rpx 0; }.rank-item-hover { opacity: .6; }.rank-icon { width: 46rpx; font-size: 32rpx; }.rank-main { flex: 1; margin: 0 14rpx; }.rank-text { display: flex; justify-content: space-between; color: #5D4037; font-size: 24rpx; }.rank-track { height: 12rpx; margin-top: 12rpx; border-radius: 6rpx; overflow: hidden; background: #F5EFE6; }.rank-fill { height: 100%; border-radius: 6rpx; background: #FF6B35; }.rank-fill.income { background: #4CAF50; }.rank-percent { min-width: 90rpx; color: #BCAAA4; font-size: 22rpx; text-align: right; }
.chart-canvas { width: 100%; }
.pie-canvas { height: 390rpx; }
.trend-chart-wrap { width: 100%; height: 330rpx; }
.trend-canvas { width: 100%; height: 100%; }
.empty-tip { padding: 64rpx 0; text-align: center; color: #BCAAA4; font-size: 26rpx; }
.chart-skeleton { display: flex; gap: 24rpx; align-items: center; padding: 10rpx 0; }
.skeleton-pie { width: 280rpx; height: 280rpx; border-radius: 50%; background: linear-gradient(100deg, #F5EDE2 20%, #FFF 50%, #F5EDE2 80%); background-size: 200% 100%; animation: skeleton-shimmer 1.2s infinite; }
.skeleton-rank { flex: 1; display: flex; flex-direction: column; gap: 18rpx; }
.skeleton-row { height: 28rpx; border-radius: 14rpx; background: linear-gradient(100deg, #F5EDE2 20%, #FFF 50%, #F5EDE2 80%); background-size: 200% 100%; animation: skeleton-shimmer 1.2s infinite; }
.skeleton-trend { width: 100%; height: 260rpx; border-radius: 12rpx; background: linear-gradient(100deg, #F5EDE2 20%, #FFF 50%, #F5EDE2 80%); background-size: 200% 100%; animation: skeleton-shimmer 1.2s infinite; }
@keyframes skeleton-shimmer { 0% { background-position: 200% 0; } 100% { background-position: -200% 0; } }

/* 自定义日期范围弹层 */
.date-range-mask {
  position: fixed;
  left: 0; top: 0; right: 0; bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 200;
}
.date-range-sheet {
  position: fixed;
  left: 0; right: 0; bottom: 0;
  background: #fff;
  border-radius: 24rpx 24rpx 0 0;
  z-index: 201;
  padding-bottom: env(safe-area-inset-bottom);
}
.date-range-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 28rpx 32rpx;
  border-bottom: 1rpx solid #F5EFE6;
}
.date-range-cancel {
  font-size: 28rpx;
  color: #999;
  padding: 0 8rpx;
}
.date-range-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #5D4037;
}
.date-range-confirm {
  font-size: 28rpx;
  color: #D96A23;
  font-weight: 600;
  padding: 0 8rpx;
}
.date-range-body {
  padding: 32rpx;
}
.date-range-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 24rpx;
  background: #FFF8EC;
  border-radius: 16rpx;
  margin-bottom: 24rpx;
}
.date-range-row:last-child {
  margin-bottom: 0;
}
.date-range-label {
  font-size: 28rpx;
  color: #8D6E63;
}
.date-range-value {
  font-size: 30rpx;
  font-weight: 600;
  color: #5D4037;
}
