.page {
  min-height: 100vh;
  padding: 0 0 100rpx;
  background: #FFF8EC;
}

.custom-nav {
  padding-bottom: 12rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: linear-gradient(180deg, #FFF8EC 0%, #FFEFD5 100%);
}

.brand-mark { width: 68rpx; height: 56rpx; display: flex; align-items: center; justify-content: center; border-radius: 50%; background: #FFF; border: 2rpx solid #5D4037; color: #5D4037; font-size: 28rpx; font-weight: 600; }
.brand-logo { width: 240rpx; height: 72rpx; }
.empty-mark { width: 112rpx; height: 96rpx; display: flex; align-items: center; justify-content: center; border-radius: 50%; background: #FFF1D6; border: 2rpx solid #F6B84C; color: #8D5A2B; font-size: 42rpx; font-weight: 600; }
.brand-title { margin-top: 8rpx; color: #5D4037; font-size: 36rpx; font-weight: 600; }

.family-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 32rpx;
  background: #fff;
}

.nickname-tip {
  display: flex;
  align-items: center;
  margin: 16rpx 24rpx 0;
  padding: 20rpx 24rpx;
  background: var(--primary-light);
  border-radius: 16rpx;
}

.nickname-tip-text {
  flex: 1;
  font-size: 24rpx;
  line-height: 34rpx;
  color: var(--text-secondary);
}

.nickname-tip-input {
  width: 180rpx;
  margin-left: 16rpx;
  padding: 10rpx 20rpx;
  background: #fff;
  border-radius: 24rpx;
  text-align: center;
  font-size: 24rpx;
  color: var(--primary-deep);
}

.nickname-tip-close {
  margin-left: 16rpx;
  padding: 0 8rpx;
  font-size: 26rpx;
  color: var(--text-tertiary);
}

.nickname-tip-placeholder {
  color: var(--primary-deep);
  font-size: 24rpx;
}

.family-title {
  display: flex;
  align-items: center;
  max-width: 72%;
  overflow: hidden;
}
.family-name {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-size: 32rpx;
  font-weight: 600;
  color: #5D4037;
}
.family-role {
  flex-shrink: 0;
  margin-left: 12rpx;
  padding: 4rpx 12rpx;
  font-size: 22rpx;
  border-radius: 20rpx;
  font-weight: 500;
}
.family-role.owner {
  background: #FFF3E6;
  color: #D96A23;
}
.family-role.member {
  background: #E8F5E9;
  color: #4CAF50;
}

.family-name-tap {
  display: flex;
  align-items: center;
  flex: 1;
  min-width: 0;
  padding: 4rpx 12rpx;
  margin: -4rpx -12rpx;
  border-radius: 10rpx;
}
.family-name-tap.family-name-tap-hover {
  background: #F5EFE6;
}
.family-name-tap .family-name {
  flex: 1;
  min-width: 0;
}
.family-edit {
  flex-shrink: 0;
  width: 32rpx;
  height: 32rpx;
  margin-left: 10rpx;
  opacity: 0.7;
  transition: opacity 0.15s ease;
}
.family-name-tap.family-name-tap-hover .family-edit {
  opacity: 1;
}

.family-switch {
  font-size: 26rpx;
  color: #FF8C42;
}

.overview-card {
  display: flex;
  flex-wrap: wrap;
  background: #fff;
  margin: 16rpx 24rpx 0;
  padding: 32rpx 0;
  border-radius: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(93, 64, 55, 0.08);
}

.overview-item {
  width: 50%;
  min-height: 120rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.overview-label {
  font-size: 22rpx;
  color: #8D6E63;
  margin-bottom: 12rpx;
}

.overview-value {
  font-size: 32rpx;
  font-weight: 600;
  color: #5D4037;
}

.overview-value.expense {
  color: #FF6B35;
}

.overview-value.income {
  color: #4CAF50;
}

.overview-divider {
  width: 1rpx;
  height: 56rpx;
  background: #eee;
}

.quick-actions {
  display: flex;
  gap: 16rpx;
  margin: 24rpx;
}

.add-bill-btn {
  flex: 1;
  margin: 0;
  height: 88rpx;
  padding: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 32rpx;
  border-radius: 44rpx;
}

.expense-btn { background: #df4b43; }
.income-btn { background: #16885f; }

.state-panel {
  padding: 160rpx 40rpx;
  text-align: center;
  color: #666;
}

.invite-panel {
  margin: 80rpx 32rpx;
  padding: 52rpx 40rpx;
  border-radius: 16rpx;
  background: #FFFFFF;
  box-shadow: 0 8rpx 24rpx rgba(93, 64, 55, .08);
  text-align: center;
}

.invite-title, .invite-family, .invite-meta, .invite-desc { display: block; }
.invite-title { color: #8D6E63; font-size: 28rpx; }
.invite-family { margin-top: 18rpx; color: #5D4037; font-size: 40rpx; font-weight: 600; }
.invite-meta, .invite-desc { margin-top: 16rpx; color: #8D6E63; font-size: 25rpx; }
.invite-confirm { margin-top: 42rpx; background: #FF8C42; color: #FFFFFF; border-radius: 12rpx; }
.invite-actions { display: flex; justify-content: center; gap: 40rpx; margin-top: 24rpx; }
.invite-cancel { color: #9D704F; font-size: 26rpx; }
.invite-remove { color: #A1887F; font-size: 26rpx; }

.state-panel.error { color: #b73636; }

.retry-btn {
  width: 240rpx;
  margin-top: 32rpx;
  background: #16885f;
  color: #fff;
}

.add-bill-btn::after {
  border: none;
}

.section {
  margin: 32rpx 24rpx 0;
}

.section-head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 16rpx; }
.view-all { color: #FF8C42; font-size: 24rpx; }
.bill-group-head { display: flex; align-items: baseline; justify-content: space-between; padding: 16rpx 8rpx 10rpx; }
.bill-date-label { font-size: 24rpx; color: #8D6E63; font-weight: 500; }
.bill-date-sum { font-size: 22rpx; color: #B0A094; }
.sum-expense { color: #FF6B35; margin-left: 12rpx; }
.sum-income { color: #4CAF50; margin-left: 12rpx; }

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #5D4037;
  margin-bottom: 16rpx;
}

.empty-tip {
  text-align: center;
  color: #bbb;
  font-size: 28rpx;
  padding: 80rpx 0;
}

.empty-illustration { display: block; width: 150rpx; height: 120rpx; margin: 0 auto 14rpx; }

.bill-item {
  display: flex;
  align-items: flex-start;
  background: #fff;
  padding: 22rpx 24rpx;
  border-radius: 16rpx;
  margin-bottom: 2rpx;
}

.bill-icon {
  width: 76rpx;
  height: 76rpx;
  line-height: 76rpx;
  text-align: center;
  font-size: 42rpx;
  background: #FFF3E6;
  border-radius: 50%;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.bill-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  min-width: 0;
}

.bill-category {
  font-size: 28rpx;
  color: #5D4037;
  font-weight: 500;
}

.bill-line1 { display: flex; align-items: center; }
.bill-merchant { margin-left: 10rpx; font-size: 24rpx; color: #A58D80; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; max-width: 280rpx; }
.bill-meta { display: flex; flex-wrap: wrap; align-items: center; gap: 8rpx 16rpx; margin-top: 8rpx; }
.meta-item { font-size: 22rpx; line-height: 1.6; color: #B0A094; }

.bill-remark {
  font-size: 24rpx;
  color: #999;
  margin-top: 8rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.bill-amount {
  font-size: 32rpx;
  font-weight: 600;
  flex-shrink: 0;
  margin-left: 16rpx;
  padding-top: 4rpx;
}

.bill-amount.expense {
  color: #FF6B35;
}

.bill-amount.income {
  color: #4CAF50;
}


/* 预算卡片 */
.budget-card {
  margin: 20rpx 24rpx 24rpx;
  padding: 24rpx 28rpx;
  background: #fff;
  border-radius: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(93, 64, 55, 0.08);
}

.budget-card-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.budget-card-label {
  font-size: 28rpx;
  font-weight: 600;
  color: #5D4037;
}

.budget-card-arrow {
  font-size: 32rpx;
  color: #BCAAA4;
}

.budget-card-row {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.budget-amount {
  font-size: 36rpx;
  font-weight: 700;
  color: #5D4037;
}

.budget-status {
  font-size: 26rpx;
  font-weight: 600;
}

.budget-status.ok { color: #4CAF50; }
.budget-status.warning { color: #F4511E; }
.budget-status.over { color: #D32F2F; }

.budget-progress {
  height: 20rpx;
  background: #F5EDE2;
  border-radius: 10rpx;
  overflow: hidden;
}

.budget-progress-fill {
  height: 100%;
  border-radius: 10rpx;
  background: linear-gradient(90deg, #FFB74D, #FF8C42);
  transition: width 0.4s ease;
}

.budget-progress-fill.warning {
  background: linear-gradient(90deg, #FF8C42, #F4511E);
}

.budget-progress-fill.over {
  background: linear-gradient(90deg, #E57373, #D32F2F);
}

.budget-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 10rpx;
}

.budget-expense {
  font-size: 24rpx;
  color: #8D6E63;
}

.budget-percent {
  font-size: 24rpx;
  font-weight: 600;
  color: #8D6E63;
}

.budget-percent.warning { color: #F4511E; }
.budget-percent.over { color: #D32F2F; }
.fab { position: fixed; right: 40rpx; bottom: 150rpx; width: 112rpx; height: 112rpx; line-height: 108rpx; text-align: center; border-radius: 50%; background: #FF8C42; color: #FFF; font-size: 56rpx; box-shadow: 0 8rpx 28rpx rgba(255, 140, 66, .35); z-index: 10; }
.sheet-mask { position: fixed; inset: 0; background: rgba(0, 0, 0, .25); z-index: 20; }
.family-sheet { position: fixed; left: 0; right: 0; bottom: 0; padding: 28rpx 32rpx calc(28rpx + env(safe-area-inset-bottom)); background: #FFFFFF; border-radius: 28rpx 28rpx 0 0; z-index: 21; }
.sheet-title { text-align: center; color: #5D4037; font-size: 32rpx; font-weight: 600; margin-bottom: 20rpx; }
.family-option, .manage-family { display: flex; justify-content: space-between; align-items: center; padding: 24rpx 8rpx; border-bottom: 1rpx solid #F5EFE6; color: #5D4037; }
.family-option-main { display: flex; align-items: center; overflow: hidden; }
.family-option-name { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; max-width: 360rpx; }
.family-option-role { flex-shrink: 0; margin-left: 12rpx; padding: 2rpx 10rpx; font-size: 20rpx; border-radius: 16rpx; font-weight: 500; }
.family-option-role.owner { background: #FFF3E6; color: #D96A23; }
.family-option-role.member { background: #E8F5E9; color: #4CAF50; }
.family-option-check { color: #D96A23; font-weight: 600; flex-shrink: 0; margin-left: 12rpx; }
.manage-family { justify-content: center; color: #FF8C42; border-bottom: 0; }

.welcome-mask { position: fixed; top: 0; left: 0; right: 0; bottom: 0; background: rgba(93, 64, 55, 0.5); z-index: 300; display: flex; align-items: center; justify-content: center; padding: 0 48rpx; }
.welcome-card { width: 100%; background: #FFF8EC; border-radius: 24rpx; padding: 48rpx 40rpx 40rpx; display: flex; flex-direction: column; align-items: center; box-shadow: 0 12rpx 40rpx rgba(93, 64, 55, 0.18); }
.welcome-illustration { width: 240rpx; height: 180rpx; }
.welcome-mark { width: 140rpx; height: 120rpx; display: flex; align-items: center; justify-content: center; border-radius: 50%; background: #FFF1D6; border: 2rpx solid #F6B84C; color: #8D5A2B; font-size: 56rpx; font-weight: 600; }
.welcome-title { margin-top: 32rpx; color: #5D4037; font-size: 38rpx; font-weight: 600; }
.welcome-desc { margin-top: 18rpx; color: #8D6E63; font-size: 26rpx; line-height: 1.7; text-align: center; }
.welcome-btn { margin-top: 44rpx; width: 100%; background: #FF8C42; color: #FFFFFF; border-radius: 12rpx; font-size: 30rpx; }

/* —— 首页最近账单：左滑删除 —— */
.bill-swipe-wrap {
  position: relative;
  overflow: hidden;
  border-radius: 16rpx;
  margin-bottom: 2rpx;
}
.bill-swipe-content {
  position: relative;
  width: 100%;
  background: #fff;
  border-radius: 16rpx;
  z-index: 1;
}
.bill-swipe-content .bill-item {
  margin-bottom: 0;
  border-radius: 16rpx;
}
.bill-swipe-content.open {
  border-radius: 16rpx 0 0 16rpx;
}
.bill-delete {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  width: 180rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #E0503C;
  color: #FFFFFF;
  font-size: 30rpx;
  font-weight: 600;
  border-radius: 0 12rpx 12rpx 0;
  z-index: 0;
}

/* —— 左滑删除引导提示 —— */
.swipe-guide {
  position: fixed;
  right: 60rpx;
  top: 55%;
  z-index: 400;
  display: flex;
  flex-direction: column;
  align-items: center;
  opacity: 0;
  transform: translateX(30rpx);
  pointer-events: none;
  transition: opacity 0.4s ease, transform 0.4s ease;
}
.swipe-guide.show {
  opacity: 1;
  transform: translateX(0);
  pointer-events: auto;
}
.swipe-guide-hand {
  font-size: 56rpx;
  animation: swipeHandNudge 1.6s ease-in-out infinite;
}
.swipe-guide-arrow {
  width: 0;
  height: 0;
  border-top: 16rpx solid transparent;
  border-bottom: 16rpx solid transparent;
  border-left: 20rpx solid rgba(93, 64, 55, 0.92);
  margin-top: -4rpx;
  margin-bottom: 4rpx;
}
.swipe-guide-text {
  background: rgba(93, 64, 55, 0.92);
  color: #FFFFFF;
  padding: 16rpx 28rpx;
  border-radius: 12rpx;
  font-size: 26rpx;
  white-space: nowrap;
  box-shadow: 0 4rpx 16rpx rgba(93, 64, 55, 0.3);
}
@keyframes swipeHandNudge {
  0%, 100% { transform: translateX(0); }
  50% { transform: translateX(-24rpx); }
}
