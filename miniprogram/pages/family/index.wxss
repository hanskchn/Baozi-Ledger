.page {
  padding: 0 24rpx 40rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #5D4037;
  margin: 32rpx 0 16rpx;
}

.family-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #fff;
  padding: 28rpx 32rpx;
  border-radius: 12rpx;
  margin-bottom: 12rpx;
}

.family-info {
  display: flex;
  flex-direction: column;
}

.family-name {
  font-size: 32rpx;
  font-weight: 500;
  color: #5D4037;
}

.family-members {
  font-size: 24rpx;
  color: #999;
  margin-top: 8rpx;
}

.family-current {
  font-size: 24rpx;
  color: #D96A23;
  background: #FFF3E6;
  padding: 6rpx 20rpx;
  border-radius: 20rpx;
}

.btn-outline {
  margin-top: 16rpx;
  background: #fff;
  color: #D96A23;
  font-size: 30rpx;
  border: 2rpx solid #D96A23;
  border-radius: 44rpx;
  height: 80rpx;
  line-height: 76rpx;
}

.member-actions {
  display: flex;
  gap: 24rpx;
}

.member-transfer {
  font-size: 26rpx;
  color: #D96A23;
}

.btn-outline::after {
  border: none;
}

.member-item {
  display: flex;
  align-items: center;
  background: #fff;
  padding: 24rpx 32rpx;
  border-radius: 12rpx;
  margin-bottom: 2rpx;
}

.member-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  margin-right: 20rpx;
  background: #F5EBDD;
}

.member-info {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.member-name {
  font-size: 30rpx;
  color: #5D4037;
  font-weight: 500;
}

.member-role {
  font-size: 24rpx;
  color: #999;
  margin-top: 6rpx;
}

.member-remove {
  font-size: 26rpx;
  color: #e54545;
}

.leave-btn { margin-top: 24rpx; background: #FFF0EB; color: #FF6B35; font-size: 28rpx; border-radius: 40rpx; }
