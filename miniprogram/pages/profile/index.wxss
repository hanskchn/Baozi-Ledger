.page {
  padding: 0 0 40rpx;
}

.user-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  background: #FFF;
  padding: 48rpx 32rpx 40rpx;
  margin-bottom: 16rpx;
}

.user-avatar {
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
  background: #f0f0f0;
}

.user-avatar-button {
  width: 140rpx;
  height: 140rpx;
  margin: 0 0 20rpx 0;
  padding: 0;
  border-radius: 50%;
  overflow: hidden;
  background: transparent;
  line-height: 0;
}

.user-avatar-button::after {
  border: 0;
}

.user-avatar-button .user-avatar {
  margin-right: 0;
}

.user-info {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.user-name {
  font-size: 34rpx;
  font-weight: 600;
  color: #5D4037;
}

.user-family {
  font-size: 26rpx;
  line-height: 36rpx;
  color: #8D6E63;
}

.menu-group {
  background: #fff;
  margin: 0 24rpx 16rpx;
  border-radius: 16rpx;
  overflow: hidden;
}

.menu-item {
  display: flex;
  align-items: center;
  padding: 28rpx 32rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-icon {
  font-size: 36rpx;
  margin-right: 20rpx;
  width: 48rpx;
  text-align: center;
}

.menu-text {
  flex: 1;
  font-size: 30rpx;
  color: #5D4037;
}

.menu-arrow {
  font-size: 36rpx;
  color: #ccc;
}

.account-danger {
  margin: 40rpx 24rpx 0;
  padding: 26rpx 0;
  border-top: 1rpx solid #F0DDD4;
  color: #C85A4B;
  font-size: 28rpx;
  text-align: center;
}

.user-family-row {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 8rpx;
}
.user-family-role {
  margin-left: 12rpx;
  padding: 0 12rpx;
  font-size: 20rpx;
  line-height: 32rpx;
  border-radius: 16rpx;
  font-weight: 500;
  flex-shrink: 0;
}
.user-family-role.owner {
  background: #FFF3E6;
  color: #D96A23;
}
.user-family-role.member {
  background: #E8F5E9;
  color: #4CAF50;
}
