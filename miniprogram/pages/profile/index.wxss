.page {
  padding: 0 0 40rpx;
}

.user-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  background: #FFF;
  padding: 48rpx 32rpx 40rpx;
  margin-bottom: 16rpx;
}

.user-avatar-wrap {
  width: 140rpx;
  height: 140rpx;
  margin-bottom: 20rpx;
}

.user-avatar {
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
  background: #f0f0f0;
}

.user-info {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.user-name {
  font-size: 34rpx;
  font-weight: 600;
  color: #5D4037;
}

.user-family {
  font-size: 26rpx;
  line-height: 36rpx;
  color: #8D6E63;
}

.menu-group {
  background: #fff;
  margin: 0 24rpx 16rpx;
  border-radius: 16rpx;
  overflow: hidden;
}

.menu-item {
  display: flex;
  align-items: center;
  padding: 28rpx 32rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-icon {
  font-size: 36rpx;
  margin-right: 20rpx;
  width: 48rpx;
  text-align: center;
}

.menu-text {
  flex: 1;
  font-size: 30rpx;
  color: #5D4037;
}

.menu-arrow {
  font-size: 36rpx;
  color: #ccc;
}

.account-danger {
  margin: 40rpx 24rpx 0;
  padding: 26rpx 0;
  border-top: 1rpx solid #F0DDD4;
  color: #C85A4B;
  font-size: 28rpx;
  text-align: center;
}

.user-family-row {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 8rpx;
}
.user-family-role {
  margin-left: 12rpx;
  padding: 0 12rpx;
  font-size: 20rpx;
  line-height: 32rpx;
  border-radius: 16rpx;
  font-weight: 500;
  flex-shrink: 0;
}
.user-family-role.owner {
  background: #FFF3E6;
  color: #D96A23;
}
.user-family-role.member {
  background: #E8F5E9;
  color: #4CAF50;
}

/* 编辑资料底部弹层 */
.profile-mask {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(93, 64, 55, 0.5);
  z-index: 300;
}
.profile-sheet {
  position: fixed;
  left: 0; right: 0; bottom: 0;
  z-index: 301;
  padding: 16rpx 40rpx calc(48rpx + env(safe-area-inset-bottom));
  background: #FFFFFF;
  border-radius: 32rpx 32rpx 0 0;
  box-shadow: 0 -8rpx 40rpx rgba(93, 64, 55, 0.15);
}
.profile-sheet-handle {
  width: 64rpx;
  height: 8rpx;
  margin: 0 auto 24rpx;
  border-radius: 4rpx;
  background: #E0E0E0;
}
.profile-sheet-title {
  display: block;
  text-align: center;
  font-size: 32rpx;
  font-weight: 600;
  color: #5D4037;
  margin-bottom: 32rpx;
}
.profile-avatar-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 32rpx;
}
.profile-avatar-btn {
  position: relative;
  width: 160rpx;
  height: 160rpx;
  padding: 0;
  margin: 0;
  border-radius: 50%;
  overflow: visible;
  background: transparent;
  line-height: 0;
}
.profile-avatar-btn::after {
  border: none;
}
.profile-avatar-img {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  background: #f0f0f0;
}
.profile-avatar-tip {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #BCAAA4;
}
.profile-field {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #F5EBE0;
}
.profile-field-label {
  font-size: 28rpx;
  color: #5D4037;
  width: 80rpx;
  flex-shrink: 0;
}
.profile-field-input {
  flex: 1;
  margin-left: 24rpx;
  font-size: 28rpx;
  color: #5D4037;
}
.profile-field-placeholder {
  color: #BCAAA4;
}
.profile-save-btn {
  margin-top: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 88rpx;
  line-height: 1;
  border-radius: 44rpx;
  background: #FF8C42;
  color: #FFFFFF;
  font-size: 30rpx;
  font-weight: 600;
}
.profile-save-btn::after {
  border: none;
}

.menu-badge {
  min-width: 32rpx;
  height: 32rpx;
  line-height: 32rpx;
  padding: 0 10rpx;
  margin-right: 12rpx;
  font-size: 20rpx;
  color: #fff;
  background: #E85D5D;
  border-radius: 16rpx;
  text-align: center;
}
