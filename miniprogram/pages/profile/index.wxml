<view class="page">
  <!-- 用户信息 -->
  <view class="user-card">
    <image class="user-avatar" src="{{avatarUrl || '/images/icons/avatar.png'}}"></image>
    <view class="user-info">
      <text class="user-name">{{nickName}}</text>
      <text class="user-family">📦 {{familyName}}</text>
    </view>
  </view>

  <!-- 功能列表 -->
  <view class="menu-group">
    <view class="menu-item" bindtap="goFamily">
      <text class="menu-icon">👥</text>
      <text class="menu-text">家庭管理</text>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-item" bindtap="goBudget">
      <text class="menu-icon">💰</text>
      <text class="menu-text">预算设置</text>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-item" bindtap="goCategory">
      <text class="menu-icon">📋</text>
      <text class="menu-text">分类管理</text>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-item" bindtap="goAccount">
      <text class="menu-icon">🏦</text>
      <text class="menu-text">账户管理</text>
      <text class="menu-arrow">›</text>
    </view>
  </view>

  <view class="menu-group">
    <view class="menu-item" bindtap="goImport">
      <text class="menu-icon">📥</text>
      <text class="menu-text">数据导入</text>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-item" bindtap="goExport">
      <text class="menu-icon">📤</text>
      <text class="menu-text">数据导出</text>
      <text class="menu-arrow">›</text>
    </view>
  </view>

  <view class="menu-group">
    <view class="menu-item">
      <text class="menu-icon">🔔</text>
      <text class="menu-text">记账提醒</text>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-item">
      <text class="menu-icon">ℹ️</text>
      <text class="menu-text">关于</text>
      <text class="menu-arrow">›</text>
    </view>
  </view>
</view>
