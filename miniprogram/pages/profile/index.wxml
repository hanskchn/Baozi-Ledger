<view class="page">
  <!-- 用户信息（纯展示，点击头像可编辑） -->
  <view class="user-card">
    <view class="user-avatar-wrap" bindtap="openProfileSheet">
      <image class="user-avatar" src="{{avatarUrl || '/images/icons/avatar.png'}}"></image>
    </view>
    <view class="user-info">
      <text class="user-name">{{nickName}}</text>
      <view class="user-family-row">
        <text class="user-family">🏠 {{familyName}}</text>
        <text wx:if="{{roleReady}}" class="user-family-role {{isOwner ? 'owner' : 'member'}}">{{isOwner ? '我的' : (familyAdminName ? familyAdminName + '的' : '成员')}}</text>
      </view>
    </view>
  </view>

  <!-- 功能列表 -->
  <view class="menu-group">
    <view class="menu-item" bindtap="openProfileSheet">
      <text class="menu-icon">👤</text>
      <text class="menu-text">编辑资料</text>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-item" bindtap="openReminderSheet">
      <text class="menu-icon">🔔</text>
      <text class="menu-text">每日记账提醒</text>
      <text class="menu-value {{reminder.enabled && reminder.remaining <= 2 ? 'warn' : ''}}">{{reminderValueText}}</text>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-item" bindtap="goFamily">
      <text class="menu-icon">👥</text>
      <text class="menu-text">家庭管理</text>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-item" bindtap="goBudget" wx:if="{{isAdmin}}">
      <text class="menu-icon">💰</text>
      <text class="menu-text">预算设置</text>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-item" bindtap="goCategory" wx:if="{{isAdmin}}">
      <text class="menu-icon">📋</text>
      <text class="menu-text">分类管理</text>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-item" bindtap="goAccount" wx:if="{{isAdmin}}">
      <text class="menu-icon">🏦</text>
      <text class="menu-text">账户管理</text>
      <text class="menu-arrow">›</text>
    </view>
  </view>

  <view class="menu-group">
    <view class="menu-item" bindtap="goImport" wx:if="{{isAdmin}}">
      <text class="menu-icon">📥</text>
      <text class="menu-text">数据导入</text>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-item" bindtap="goExport" wx:if="{{isAdmin}}">
      <text class="menu-icon">📤</text>
      <text class="menu-text">数据导出</text>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-item" bindtap="goLogs" wx:if="{{isAdmin}}"><text class="menu-icon">🧾</text><text class="menu-text">操作记录</text><text class="menu-arrow">›</text></view>
  </view>

  <view class="menu-group">
    <view class="menu-item" bindtap="goFeedback">
      <text class="menu-icon">💬</text>
      <text class="menu-text">意见反馈</text>
      <text wx:if="{{unreadCount > 0}}" class="menu-badge">{{unreadCount > 99 ? '99+' : unreadCount}}</text>
      <text class="menu-arrow">›</text>
    </view>
    <view wx:if="{{isDeveloper}}" class="menu-item" bindtap="goFeedbackAdmin">
      <text class="menu-icon">🛠️</text>
      <text class="menu-text">反馈管理</text>
      <text class="menu-arrow">›</text>
    </view>
    <view wx:if="{{isDeveloper}}" class="menu-item" bindtap="goTestTools">
      <text class="menu-icon">🧹</text>
      <text class="menu-text">测试工具</text>
      <text class="menu-arrow">›</text>
    </view>
  </view>

  <view class="account-danger" bindtap="cancelAccount">注销账号</view>

  <!-- 编辑资料 底部弹层 -->
  <view class="profile-mask" wx:if="{{showProfileSheet}}" bindtap="closeProfileSheet" catchtouchmove="noop"></view>
  <view class="profile-sheet" wx:if="{{showProfileSheet}}" catchtouchmove="noop">
    <view class="profile-sheet-handle"></view>
    <text class="profile-sheet-title">编辑个人资料</text>
    <view class="profile-avatar-wrap">
      <button class="profile-avatar-btn" open-type="chooseAvatar" bindchooseavatar="onSheetChooseAvatar" catchtap="noop">
        <image class="profile-avatar-img" src="{{sheetAvatarUrl || '/images/icons/avatar.png'}}"></image>
      </button>
      <text class="profile-avatar-tip">点头像更换</text>
    </view>
    <view class="profile-field">
      <text class="profile-field-label">昵称</text>
      <input
        class="profile-field-input"
        type="nickname"
        placeholder="点此使用微信昵称"
        placeholder-class="profile-field-placeholder"
        bindinput="onSheetNicknameInput"
        bindblur="onSheetNicknameInput"
        bindnicknamereview="onSheetNicknameInput"
      />
    </view>
    <button class="profile-save-btn" bindtap="saveProfile" loading="{{savingProfile}}" disabled="{{savingProfile}}">保存</button>
  </view>

  <!-- 每日记账提醒 底部弹层 -->
  <view class="profile-mask" wx:if="{{showReminderSheet}}" bindtap="closeReminderSheet" catchtouchmove="noop"></view>
  <view class="profile-sheet" wx:if="{{showReminderSheet}}" catchtouchmove="noop">
    <view class="profile-sheet-handle"></view>
    <text class="profile-sheet-title">每日记账提醒</text>

    <view class="reminder-row">
      <view class="reminder-row-main">
        <text class="reminder-row-title">开启提醒</text>
        <text class="reminder-row-desc">到点通过微信「服务通知」提醒你记账</text>
      </view>
      <switch checked="{{reminder.enabled}}" color="#FF8C42" disabled="{{reminderSaving}}" bindchange="onReminderToggle" />
    </view>

    <text class="reminder-section">提醒时间</text>
    <view
      wx:for="{{reminderOptions}}"
      wx:key="hour"
      class="reminder-option {{reminder.remindHour === item.hour ? 'active' : ''}}"
      bindtap="pickRemindHour"
      data-hour="{{item.hour}}"
    >
      <view class="reminder-option-main">
        <text class="reminder-option-label">{{item.label}}</text>
        <text class="reminder-option-desc">{{item.desc}}</text>
      </view>
      <text wx:if="{{reminder.remindHour === item.hour}}" class="reminder-option-check">✓</text>
    </view>

    <view class="reminder-quota" wx:if="{{showQuota}}">
      <text wx:if="{{renewBlocked}}" class="reminder-quota-text warn">无法自动补足，请前往「设置」重新允许</text>
      <text wx:else class="reminder-quota-text">{{reminderQuotaText}}</text>
      <button
        wx:if="{{!renewBlocked}}"
        class="reminder-topup-btn"
        size="mini"
        disabled="{{reminderSaving}}"
        bindtap="manualTopup"
      >补一条</button>
      <text wx:if="{{renewBlocked}}" class="reminder-renew-link" catchtap="openReminderSettings">去设置重新允许</text>
    </view>

    <text class="reminder-tip">首次授权请勾选「总是保持以上选择」，之后打开小程序会自动为您补足推送额度，无需手动续订。</text>
  </view>

  <!-- 开启提醒 · 瑞幸式底部授权说明 -->
  <view class="profile-mask" wx:if="{{showReminderGuide}}" bindtap="closeReminderGuide" catchtouchmove="noop"></view>
  <view class="guide-sheet" wx:if="{{showReminderGuide}}" catchtouchmove="noop">
    <view class="profile-sheet-handle"></view>
    <text class="guide-title">开启每日记账提醒</text>
    <text class="guide-subtitle">通过微信「服务通知」定时提醒，不再错过记账</text>

    <view class="guide-time">
      <text class="guide-time-label">提醒时间</text>
      <text class="guide-time-value">每天 {{guideReminderTimeText}}</text>
    </view>

    <view class="guide-points">
      <view class="guide-point">
        <text class="guide-point-title">1 · 会弹一次窗</text>
        <text class="guide-point-desc">点击下方按钮后将弹出一次微信授权确认（仅首次）：点「允许」并勾选「总是保持以上选择」即可</text>
      </view>
      <view class="guide-point">
        <text class="guide-point-title">2 · 自动补足</text>
        <text class="guide-point-desc">勾选后每次打开小程序会自动补足额度，全程无感、不再弹窗</text>
      </view>
      <view class="guide-point">
        <text class="guide-point-title">3 · 随时可关</text>
        <text class="guide-point-desc">想暂停时在「我的 → 每日记账提醒」一键关闭即可</text>
      </view>
    </view>

    <button class="guide-confirm-btn" bindtap="confirmReminderGuide" disabled="{{reminderSaving}}">同意并开启</button>
    <button class="guide-cancel-btn" bindtap="closeReminderGuide">暂不开启</button>
  </view>


<privacy-popup />
</view>
