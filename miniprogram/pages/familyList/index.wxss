.page {
  padding: 24rpx 24rpx 200rpx;
}

.card {
  background: #fff;
  border-radius: 20rpx;
  overflow: hidden;
}

.card-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 32rpx 20rpx;
}

.card-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #5D4037;
}

.card-extra {
  font-size: 24rpx;
  color: #BCAAA4;
}

.ledger-item {
  display: flex;
  align-items: center;
  padding: 26rpx 32rpx;
  border-top: 2rpx solid #F5EFE6;
}

.ledger-item-current {
  background: #FFF8EC;
}

.ledger-icon {
  width: 76rpx;
  height: 76rpx;
  border-radius: 22rpx;
  background: linear-gradient(135deg, #FFB07A, #FF8C42);
  color: #fff;
  font-size: 32rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 22rpx;
  flex-shrink: 0;
}

.ledger-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  min-width: 0;
}

.ledger-line {
  display: flex;
  align-items: center;
}

.ledger-name {
  font-size: 30rpx;
  color: #5D4037;
  font-weight: 500;
  max-width: 320rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.badge {
  font-size: 20rpx;
  font-weight: 600;
  padding: 4rpx 14rpx;
  border-radius: 16rpx;
  margin-left: 12rpx;
  white-space: nowrap;
}

.badge-admin {
  background: #FFF3E6;
  color: #D96A23;
}

.badge-member {
  background: #F5F0E8;
  color: #8D6E63;
}

.ledger-meta {
  font-size: 22rpx;
  color: #BCAAA4;
  margin-top: 6rpx;
}

.ledger-tick {
  color: #FF8C42;
  font-size: 34rpx;
  font-weight: 700;
  margin-left: 12rpx;
  flex-shrink: 0;
}

.tip {
  display: block;
  font-size: 22rpx;
  color: #8D6E63;
  background: #FFF3E6;
  border-radius: 16rpx;
  padding: 18rpx 24rpx;
  margin-top: 24rpx;
  line-height: 1.6;
}

/* 创建入口固定在底部，不随账本数量漂移 */
.footer {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 20rpx 24rpx calc(24rpx + env(safe-area-inset-bottom));
  background: linear-gradient(180deg, rgba(255, 248, 236, 0), #FFF8EC 40%);
}

.primary-btn {
  background: linear-gradient(135deg, #FF8C42, #FF6B35);
  color: #fff;
  text-align: center;
  font-size: 32rpx;
  font-weight: 600;
  padding: 26rpx 0;
  border-radius: 48rpx;
  box-shadow: 0 8rpx 20rpx rgba(255, 107, 53, 0.32);
}

.recoverable-card {
  margin-top: 24rpx;
}

.ledger-item-dissolved {
  opacity: 0.75;
}

.ledger-icon-dissolved {
  background: linear-gradient(135deg, #BCAAA4, #8D6E63);
}

.badge-dissolved {
  background: #FBE9E7;
  color: #BF360C;
}

.ledger-meta-warn {
  color: #D84315 !important;
}

.restore-btn {
  margin-left: 12rpx;
  padding: 10rpx 28rpx;
  font-size: 24rpx;
  font-weight: 600;
  color: #FF6B35;
  background: #FFF3E6;
  border-radius: 28rpx;
  flex-shrink: 0;
}
