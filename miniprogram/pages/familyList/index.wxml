<view class="page">
  <view class="card">
    <view class="card-head">
      <text class="card-title">我加入的账本</text>
      <text class="card-extra">{{families.length}} 个</text>
    </view>
    <view
      class="ledger-item {{item.id === currentFamilyId ? 'ledger-item-current' : ''}}"
      wx:for="{{families}}"
      wx:key="id"
      data-id="{{item.id}}"
      bindtap="switchFamily"
    >
      <view class="ledger-icon">{{item.iconText}}</view>
      <view class="ledger-info">
        <view class="ledger-line">
          <text class="ledger-name">{{item.name}}</text>
          <text class="badge badge-admin" wx:if="{{item.role === 'admin'}}">管理员</text>
          <text class="badge badge-member" wx:else>成员</text>
        </view>
        <text class="ledger-meta">{{item.memberCount}} 位成员 · 累计 {{item.totalBillCount}} 笔</text>
      </view>
      <text class="ledger-tick" wx:if="{{item.id === currentFamilyId}}">✓</text>
    </view>
  </view>
  <text class="tip">点任意一行即切换当前账本并返回。</text>

  <view class="card recoverable-card" wx:if="{{recoverableFamilies.length > 0}}">
    <view class="card-head">
      <text class="card-title">可还原账本</text>
      <text class="card-extra">30 天内可还原</text>
    </view>
    <view class="ledger-item ledger-item-dissolved" wx:for="{{recoverableFamilies}}" wx:key="id">
      <view class="ledger-icon ledger-icon-dissolved">{{item.iconText}}</view>
      <view class="ledger-info">
        <view class="ledger-line">
          <text class="ledger-name">{{item.name}}</text>
          <text class="badge badge-dissolved">已解散</text>
        </view>
        <text class="ledger-meta ledger-meta-warn">{{item.daysRemaining}} 天后永久删除 · 点击还原</text>
      </view>
      <view class="restore-btn" data-id="{{item.id}}" catchtap="restoreFamily">还原</view>
    </view>
  </view>
</view>

<view class="footer">
  <view class="primary-btn" bindtap="createFamily">＋ 创建新账本</view>
<privacy-popup />
</view>
