<view class="page">
  <view class="type-tabs">
    <view class="type-tab {{type === 'expense' ? 'active' : ''}}" data-type="expense" bindtap="switchType">支出</view>
    <view class="type-tab {{type === 'income' ? 'active' : ''}}" data-type="income" bindtap="switchType">收入</view>
  </view>

  <view class="category-list">
    <view class="category-group {{item.enabled === false ? 'is-disabled' : ''}}" wx:for="{{categories}}" wx:key="id">
      <view class="category1-header">
        <text class="category1-icon">{{item.icon}}</text>
        <text class="category1-name">{{item.name}}</text>
        <text class="category1-edit" data-id="{{item.id}}" bindtap="editCategory">编辑</text>
        <text class="category-action" data-id="{{item.id}}" data-enabled="{{item.enabled !== false}}" bindtap="toggleCategory">{{item.enabled === false ? '恢复' : '停用'}}</text>
      </view>
      <view class="category2-list">
        <view class="category2-item {{child.enabled === false ? 'is-disabled' : ''}}" wx:for="{{item.children}}" wx:for-item="child" wx:key="id">
          <text class="category2-icon">{{child.icon}}</text>
          <text class="category2-name">{{child.name}}</text>
          <text class="category2-edit" data-id="{{child.id}}" bindtap="editChildCategory">编辑</text>
          <text class="category2-action" data-id="{{child.id}}" data-enabled="{{child.enabled !== false}}" bindtap="toggleCategory">{{child.enabled === false ? '恢复' : '停用'}}</text>
        </view>
        <view wx:if="{{item.enabled !== false}}" class="category2-add" data-pid="{{item.id}}" bindtap="addCategory2">+ 添加二级分类</view>
      </view>
    </view>
  </view>

  <button class="btn-outline" bindtap="addCategory1">+ 添加一级分类</button>
</view>
