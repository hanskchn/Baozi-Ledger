.page {
  padding: 0 0 120rpx;
}

.form-row.readonly .form-value {
  color: #777;
}

.type-tabs {
  display: flex;
  background: #fff;
  padding: 16rpx 24rpx;
}

.type-tab {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  font-size: 30rpx;
  color: #999;
  border-radius: 12rpx;
  margin: 0 8rpx;
}

.type-tab.active.expense {
  background: #fff0f0;
  color: #e54545;
  font-weight: 600;
}

.type-tab.active.income {
  background: #e8f8ee;
  color: #07C160;
  font-weight: 600;
}

.amount-row {
  display: flex;
  align-items: center;
  background: #fff;
  padding: 32rpx 32rpx;
  margin-bottom: 16rpx;
}

.amount-symbol {
  font-size: 48rpx;
  color: #333;
  font-weight: 600;
  margin-right: 16rpx;
}

.amount-input {
  flex: 1;
  font-size: 56rpx;
  font-weight: 600;
  color: #333;
}

.form-row {
  display: flex;
  align-items: center;
  background: #fff;
  padding: 28rpx 32rpx;
  border-bottom: 1rpx solid #f5f5f5;
}

.form-label {
  width: 120rpx;
  font-size: 30rpx;
  color: #333;
}

.form-value {
  flex: 1;
  font-size: 30rpx;
  color: #333;
}

.placeholder {
  color: #ccc;
}

.form-input {
  flex: 1;
  font-size: 30rpx;
  color: #333;
}

.form-arrow {
  font-size: 36rpx;
  color: #ccc;
}

.save-btn {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  height: 100rpx;
  line-height: 100rpx;
  background: #07C160;
  color: #fff;
  font-size: 34rpx;
  border-radius: 0;
  text-align: center;
}

.save-btn::after {
  border: none;
}

/* 分类选择器 */
.category-picker {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0,0,0,0.5);
  z-index: 1000;
}

.picker-content {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  background: #fff;
  border-radius: 24rpx 24rpx 0 0;
  max-height: 70vh;
  display: flex;
  flex-direction: column;
}

.picker-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 32rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.picker-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
}

.picker-close {
  font-size: 36rpx;
  color: #999;
  padding: 0 16rpx;
}

.picker-body {
  flex: 1;
  overflow-y: auto;
  padding: 16rpx 0;
}

.category-group {
  margin-bottom: 16rpx;
}

.category1-item {
  display: flex;
  align-items: center;
  padding: 24rpx 32rpx;
  background: #f8f8f8;
}

.category1-icon {
  font-size: 32rpx;
  margin-right: 16rpx;
}

.category1-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
}

.category2-list {
  background: #fff;
}

.category2-item {
  display: flex;
  align-items: center;
  padding: 20rpx 32rpx 20rpx 80rpx;
  border-bottom: 1rpx solid #f5f5f5;
}

.category2-icon {
  font-size: 28rpx;
  margin-right: 12rpx;
}

.category2-name {
  font-size: 28rpx;
  color: #555;
}
