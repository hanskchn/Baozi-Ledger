<view class="page">
  <view class="filter-list">
    <!-- 时间 -->
    <view class="filter-row" bindtap="openTimeSheet">
      <view class="filter-row-left">
        <text class="filter-icon">🕒</text>
        <text class="filter-label">时间</text>
      </view>
      <text class="filter-value {{filterMonth || filterDateStart || filterDateEnd ? 'active' : ''}}">{{timeDisplay}}</text>
      <text class="filter-arrow">›</text>
    </view>

    <!-- 分类 -->
    <view class="filter-row" bindtap="openCategorySheet">
      <view class="filter-row-left">
        <text class="filter-icon">🏷️</text>
        <text class="filter-label">分类</text>
      </view>
      <text class="filter-value {{filterCategory ? 'active' : ''}}">{{categoryDisplay}}</text>
      <text class="filter-arrow">›</text>
    </view>

    <!-- 账户 -->
    <picker mode="selector" range="{{accountOptions}}" value="{{accountIndex}}" bindchange="onAccountChange">
      <view class="filter-row">
        <view class="filter-row-left">
          <text class="filter-icon">💳</text>
          <text class="filter-label">账户</text>
        </view>
        <text class="filter-value {{filterAccount ? 'active' : ''}}">{{accountDisplay}}</text>
        <text class="filter-arrow">›</text>
      </view>
    </picker>

    <!-- 流水类型 -->
    <picker mode="selector" range="{{typeOptions}}" value="{{typeIndex}}" bindchange="onTypeChange">
      <view class="filter-row">
        <view class="filter-row-left">
          <text class="filter-icon">📊</text>
          <text class="filter-label">流水类型</text>
        </view>
        <text class="filter-value {{filterType ? 'active' : ''}}">{{typeDisplay}}</text>
        <text class="filter-arrow">›</text>
      </view>
    </picker>

    <!-- 成员 -->
    <picker mode="selector" range="{{memberOptions}}" value="{{memberIndex}}" bindchange="onMemberChange">
      <view class="filter-row">
        <view class="filter-row-left">
          <text class="filter-icon">👤</text>
          <text class="filter-label">成员</text>
        </view>
        <text class="filter-value {{filterMember ? 'active' : ''}}">{{memberDisplay}}</text>
        <text class="filter-arrow">›</text>
      </view>
    </picker>

    <!-- 商家 -->
    <view class="filter-row" bindtap="editMerchant">
      <view class="filter-row-left">
        <text class="filter-icon">🏪</text>
        <text class="filter-label">商家</text>
      </view>
      <text class="filter-value {{merchant ? 'active' : ''}}">{{merchant || '全部'}}</text>
      <text class="filter-arrow">›</text>
    </view>

    <!-- 金额 -->
    <view class="filter-row amount-row">
      <view class="filter-row-left">
        <text class="filter-icon">💰</text>
        <text class="filter-label">金额</text>
      </view>
      <input class="amount-input" placeholder="最低" value="{{minAmount}}" bindinput="onMinAmountInput" bindblur="onMinAmountBlur" type="digit" />
      <text class="amount-sep">－</text>
      <input class="amount-input" placeholder="最高" value="{{maxAmount}}" bindinput="onMaxAmountInput" bindblur="onMaxAmountBlur" type="digit" />
    </view>

    <!-- 备注 -->
    <view class="filter-row" bindtap="editRemark">
      <view class="filter-row-left">
        <text class="filter-icon">📝</text>
        <text class="filter-label">备注</text>
      </view>
      <text class="filter-value {{remark ? 'active' : ''}}">{{remark || '填写备注关键词'}}</text>
      <text class="filter-arrow">›</text>
    </view>
  </view>

  <view class="bottom-bar">
    <view class="btn-reset" bindtap="onReset">重置</view>
    <view class="btn-confirm" bindtap="onConfirm">确定</view>
  </view>

  <!-- 分类选择弹层 -->
  <view class="cat-sheet-mask" wx:if="{{showCategorySheet}}" bindtap="closeCategorySheet"></view>
  <view class="cat-sheet" wx:if="{{showCategorySheet}}" catchtap="stopPropagation">
    <view class="cat-sheet-header">
      <text class="cat-sheet-title">选择分类</text>
      <text class="cat-sheet-close" bindtap="closeCategorySheet">✕</text>
    </view>
    <scroll-view scroll-y class="cat-sheet-body">
      <view class="cat-all {{!filterCategory ? 'active' : ''}}" data-name="" bindtap="selectCategory">
        <text class="cat-all-icon">📂</text>
        <text>全部分类</text>
      </view>
      <view wx:for="{{visibleCategoryGroups}}" wx:key="name" wx:for-item="group" class="cat-group">
        <view class="cat-group-head {{group.active ? 'active' : ''}}" data-name="{{group.name}}" data-type="{{group.type}}" data-level="category1" bindtap="selectCategory">
          <text class="cat-group-icon">{{group.icon}}</text>
          <text class="cat-group-name">{{group.name}}{{group.active ? ' ✓' : ''}}</text>
          <text class="cat-group-type type-{{group.type}}">{{group.typeLabel}}</text>
        </view>
        <view class="cat-children">
          <view
            wx:for="{{group.children}}"
            wx:key="name"
            wx:for-item="child"
            class="cat-child {{child.active ? 'active' : ''}}"
            data-name="{{child.name}}"
            data-type="{{child.type}}"
            data-level="category2"
            bindtap="selectCategory"
          >
            <text class="cat-child-icon">{{child.icon}}</text>
            <text class="cat-child-name">{{child.name}}</text>
          </view>
        </view>
      </view>
      <view wx:if="{{visibleCategoryGroups.length === 0}}" class="cat-empty">当前类型下暂无分类</view>
    </scroll-view>
  </view>

  <!-- 时间选择弹层 -->
  <view class="time-sheet-mask" wx:if="{{showTimeSheet}}" bindtap="closeTimeSheet"></view>
  <view class="time-sheet" wx:if="{{showTimeSheet}}" catchtap="stopPropagation">
    <view class="time-sheet-header">
      <text class="time-sheet-title">选择时间</text>
      <text class="time-sheet-close" bindtap="closeTimeSheet">✕</text>
    </view>
    <view class="time-sheet-body">
      <view class="quick-grid">
        <view class="quick-chip {{quick === 'thisMonth' ? 'active' : ''}}" data-key="thisMonth" bindtap="selectQuick">本月</view>
        <view class="quick-chip {{quick === 'lastMonth' ? 'active' : ''}}" data-key="lastMonth" bindtap="selectQuick">上月</view>
        <view class="quick-chip {{quick === 'thisYear' ? 'active' : ''}}" data-key="thisYear" bindtap="selectQuick">今年</view>
        <view class="quick-chip {{quick === 'all' ? 'active' : ''}}" data-key="all" bindtap="selectQuick">全部</view>
      </view>

      <view class="time-section">
        <view class="time-section-head">
          <text class="quick-chip small {{timeMode === 'month' ? 'active' : ''}}" data-key="customMonth" bindtap="selectQuick">选择月份</text>
        </view>
        <picker wx:if="{{timeMode === 'month'}}" mode="date" fields="month" value="{{tempMonth}}" bindchange="onTempMonthChange">
          <view class="picker-field">{{tempMonth || '请选择月份'}}</view>
        </picker>
      </view>

      <view class="time-section">
        <view class="time-section-head">
          <text class="quick-chip small {{timeMode === 'range' ? 'active' : ''}}" data-key="customRange" bindtap="selectQuick">自定义范围</text>
        </view>
        <view wx:if="{{timeMode === 'range'}}" class="range-row">
          <picker mode="date" value="{{tempDateStart}}" bindchange="onTempStartChange">
            <view class="picker-field">{{tempDateStart || '开始日期'}}</view>
          </picker>
          <text class="range-sep">至</text>
          <picker mode="date" value="{{tempDateEnd}}" bindchange="onTempEndChange">
            <view class="picker-field">{{tempDateEnd || '结束日期'}}</view>
          </picker>
        </view>
      </view>
    </view>
    <view class="time-sheet-footer">
      <view class="time-btn-cancel" bindtap="closeTimeSheet">取消</view>
      <view class="time-btn-confirm" bindtap="confirmTimeSheet">确定</view>
    </view>
  </view>
</view>
