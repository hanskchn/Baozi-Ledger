page {
  --primary: #FF8C42;
  --primary-light: #FFF3E6;
  --primary-deep: #FF6B35;
  --expense: #FF6B35;
  --income: #4CAF50;
  --expense-bg: #FFF0EB;
  --income-bg: #E8F5E9;
  --text-primary: #5D4037;
  --text-secondary: #8D6E63;
  --text-tertiary: #BCAAA4;
  background: #FFF8EC;
  font-family: -apple-system, "PingFang SC", "Helvetica Neue", sans-serif;
  color: #5D4037;
  font-size: 28rpx;
  min-height: 100vh;
}

view, text {
  box-sizing: border-box;
}

button {
  background: initial;
}

button:focus {
  outline: 0;
}

button::after {
  border: none;
}

/* ===== 列表通用状态（加载中 / 到底 / 错误），供各列表页复用 ===== */
.list-loading,
.list-footer {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 36rpx 0 12rpx;
  color: #A1887F;
  font-size: 24rpx;
}

.loading-spinner {
  width: 32rpx;
  height: 32rpx;
  border: 4rpx solid #F0E6DC;
  border-top-color: #D96A23;
  border-radius: 50%;
  margin-right: 14rpx;
  animation: spin 0.8s linear infinite;
}

.loading-spinner.small {
  width: 26rpx;
  height: 26rpx;
  border-width: 3rpx;
  margin-right: 10rpx;
}

@keyframes spin {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}

.list-error {
  padding: 48rpx 24rpx;
  text-align: center;
  color: #C62828;
  font-size: 26rpx;
}

.list-error-tip {
  color: #A1887F;
  font-size: 24rpx;
  margin-top: 8rpx;
}
