page {
  --primary: #FF8C42;
  --primary-light: #FFF3E6;
  --primary-deep: #FF6B35;
  --expense: #FF6B35;
  --income: #4CAF50;
  --expense-bg: #FFF0EB;
  --income-bg: #E8F5E9;
  --text-primary: #5D4037;
  --text-secondary: #8D6E63;
  --text-tertiary: #BCAAA4;
  background: #FFF8EC;
  font-family: -apple-system, "PingFang SC", "Helvetica Neue", sans-serif;
  color: #5D4037;
  font-size: 28rpx;
}

view, text {
  box-sizing: border-box;
}

button {
  background: initial;
}

button:focus {
  outline: 0;
}

button::after {
  border: none;
}
